# https://ghostty.org/docs/config

font-family = MonaspiceNe Nerd Font
font-family-italic = MonaspiceRn Nerd Font
# Monaspace texture healing needs the `calt` feature: don't disable it.
font-size = 14
# Written by `theme sync`; ? = no error while it is missing
config-file = ?theme.conf
background-opacity = 1
window-padding-x = 8
window-padding-y = 6
cursor-style = block
mouse-hide-while-typing = true
copy-on-select = clipboard
confirm-close-surface = false

macos-option-as-alt = true
macos-titlebar-style = tabs

shell-integration = zsh
# No ssh features: Ghostty's ssh wrapper left ControlMaster processes attached to tabs;
# install the terminfo on servers instead.
shell-integration-features = cursor,sudo,title,no-ssh-env,no-ssh-terminfo

keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+shift+enter=toggle_split_zoom
keybind = cmd+shift+r=reload_config
# Clear the tmux pane: Ctrl-Space (prefix, \x00) then Ctrl-L (\x0c)
keybind = cmd+k=text:\x00\x0c
# Same on Linux, which has no Cmd
keybind = ctrl+shift+k=text:\x00\x0c
