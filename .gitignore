# Files that `theme sync` generates per machine; they must never be committed.
# Ghostty include with the light/dark theme pair
ghostty/.config/ghostty/theme.conf
# downloaded themes copied for Ghostty
ghostty/.config/ghostty/themes/
# the generated iTerm profile (old layout linked it from here)
iterm/Library/
# Claude Code worktrees and personal settings of this repo (the global ignore may not be installed)
/.claude/worktrees/
/.claude/settings.local.json
