#!/usr/bin/env bash
# Opens Mermaid diagrams in the browser, offline: one self-contained page in a private temp folder.
# A .md file gives one diagram per ```mermaid block; a .mmd or .mermaid file is one diagram.
# Stdin (no file, or -) is read as Markdown if it has a ```mermaid fence, else as one diagram.
# The page loads the vendored mermaid.min.js from its own folder and makes no network requests.
# Usage: mermaid-open [file]
set -euo pipefail

case "${1:-}" in
  -h | --help)
    echo "Usage: mermaid-open [file]   (.md: every mermaid block; .mmd/.mermaid: one diagram; no file or -: stdin)"
    exit 0
    ;;
esac
[[ $# -le 1 ]] || { echo "Usage: mermaid-open [file]" >&2; exit 1; }

self="$0"
while [[ -L "$self" ]]; do # the command is a symlink into the repo
  link="$(readlink "$self")"
  case "$link" in /*) self="$link" ;; *) self="$(dirname "$self")/$link" ;; esac
done
share="$(cd "$(dirname "$self")/../share/mermaid-open" && pwd)"

opener=xdg-open
[[ "$(uname -s)" == Darwin ]] && opener=open
command -v "$opener" >/dev/null 2>&1 || { echo "mermaid-open: $opener is not installed" >&2; exit 1; }

umask 077
base="${TMPDIR:-/tmp}"
base="${base%/}"
find "$base" -maxdepth 1 -type d -name 'mermaid-open.*' -mmin +1440 -exec rm -rf {} + 2>/dev/null || true
out="$(mktemp -d "$base/mermaid-open.XXXXXX")"
chmod 700 "$out"

fence='^[[:space:]]*```+[[:space:]]*mermaid[[:space:]]*$'
file="${1:--}"
if [[ "$file" == - ]]; then
  name=stdin
  cat >"$out/input"
  if grep -Eq "$fence" "$out/input"; then mode=md; else mode=whole; fi
else
  [[ -f "$file" ]] || { rm -rf "$out"; echo "mermaid-open: $file: no such file" >&2; exit 1; }
  name="$(basename "$file")"
  cp "$file" "$out/input"
  case "$file" in *.mmd | *.mermaid) mode=whole ;; *) mode=md ;; esac
fi

# Same fence rules as the nvim preview: an unclosed block is ignored. Prints the number of diagrams.
count="$(awk -v mode="$mode" -v name="$name" -v dest="$out/sections.html" '
  function esc(s) { gsub(/&/, "\\&amp;", s); gsub(/</, "\\&lt;", s); gsub(/>/, "\\&gt;", s); return s }
  function emit(line, body) {
    n++
    printf "<section><h2>%s:%d</h2><pre class=\"src\" hidden>%s</pre><div class=\"out\"></div></section>\n", esc(name), line, body > dest
  }
  { sub(/\r$/, "") }
  mode == "whole" { body = body (NR > 1 ? "\n" : "") esc($0); if ($0 ~ /[^[:space:]]/) any = 1; next }
  !start && $0 ~ /^[ \t]*```+[ \t]*mermaid[ \t]*$/ { start = NR; body = ""; next }
  start && $0 ~ /^[ \t]*```+[ \t]*$/ { emit(start, body); start = 0; next }
  start { body = body (NR > start + 1 ? "\n" : "") esc($0) }
  END {
    if (mode == "whole" && any) emit(1, body)
    print n + 0
  }' "$out/input")"

if [[ "$count" -eq 0 ]]; then
  rm -rf "$out"
  echo "mermaid-open: no mermaid diagrams found in $name" >&2
  exit 1
fi

cp "$share/mermaid.min.js" "$out/mermaid.min.js"
{
  cat <<'HTML'
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>Mermaid</title>
<style>
  :root { --bg: #fff; --fg: #1f2328; --muted: #656d76; --line: #d0d7de; --err: #cf222e; }
  @media (prefers-color-scheme: dark) {
    :root { --bg: #0d1117; --fg: #e6edf3; --muted: #8b949e; --line: #30363d; --err: #ff7b72; }
  }
  body { margin: 0; padding: 16px; background: var(--bg); color: var(--fg); font: 15px/1.4 system-ui, sans-serif; }
  section { margin: 0 0 24px; border: 1px solid var(--line); border-radius: 6px; }
  h2 { margin: 0; padding: 6px 12px; border-bottom: 1px solid var(--line); font: 13px ui-monospace, monospace; color: var(--muted); }
  .out { padding: 12px; overflow-x: auto; }
  .out svg { display: block; max-width: none; margin: 0 auto; }
  .err { margin: 0; color: var(--err); white-space: pre-wrap; font: 13px ui-monospace, monospace; }
</style>
</head>
<body>
HTML
  cat "$out/sections.html"
  cat <<'HTML'
<script src="mermaid.min.js"></script>
<script>
  var dark = window.matchMedia("(prefers-color-scheme: dark)");
  var seq = 0;
  async function renderAll() {
    mermaid.initialize({ startOnLoad: false, theme: dark.matches ? "dark" : "default", suppressErrorRendering: true });
    for (const sec of document.querySelectorAll("section")) {
      const out = sec.querySelector(".out");
      out.textContent = "";
      try {
        const { svg } = await mermaid.render("m" + ++seq, sec.querySelector(".src").textContent);
        out.innerHTML = svg;
        const el = out.querySelector("svg");
        const vb = el.viewBox && el.viewBox.baseVal;
        if (vb && vb.width) { el.style.width = vb.width + "px"; el.removeAttribute("height"); }
        el.style.maxWidth = "none";
      } catch (e) {
        const pre = document.createElement("pre");
        pre.className = "err";
        pre.textContent = String((e && e.message) || e);
        out.appendChild(pre);
      }
      const stray = document.getElementById("dm" + seq);
      if (stray) stray.remove();
    }
  }
  renderAll();
  dark.addEventListener("change", renderAll);
</script>
</body>
</html>
HTML
} >"$out/index.html"
rm -f "$out/input" "$out/sections.html"

echo "mermaid-open: $out/index.html"
"$opener" "$out/index.html" >/dev/null 2>&1 || { echo "mermaid-open: $opener failed" >&2; exit 1; }
