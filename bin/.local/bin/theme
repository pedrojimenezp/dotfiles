#!/usr/bin/env bash
# theme: pick terminal color themes from Ghostty's collection and apply them everywhere.
# The light/dark pair lives in ~/.config/theme/config (tracked), with optional nvim_light and
# nvim_dark names that only Neovim reads; the mode (auto, light, dark)
# is per machine in ~/.local/state/theme. Works with macOS bash 3.2.
# Usage: see usage() below, or run `theme help`.
set -euo pipefail

# --- Paths and constants ---
CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/theme/config" # tracked; a symlink into the repo
STATE_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/theme"
CACHE_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/theme/themes"
LIST_CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/theme/list"
GHOSTTY_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/ghostty"
NVIM_LIST="${THEME_NVIM_LIST:-${XDG_CONFIG_HOME:-$HOME/.config}/nvim/themes.tsv}" # original Neovim themes: name, colorscheme, brightness, [nvim]
ITERM_TEMPLATE="${XDG_CONFIG_HOME:-$HOME/.config}/iterm/dotfiles-profile.plist"
ITERM_PROFILE="$HOME/Library/Application Support/iTerm2/DynamicProfiles/dotfiles.plist"
UPSTREAM="mbadolato/iTerm2-Color-Schemes" # holds Ghostty's theme collection
RAW_URL="https://raw.githubusercontent.com/$UPSTREAM/master/ghostty"
API_URL="https://api.github.com/repos/$UPSTREAM/contents/ghostty"
DEFAULT_LIGHT="GitHub Light Default"
DEFAULT_DARK="TokyoNight Night"
# Ghostty's bundled themes, first match wins; THEME_GHOSTTY_DIRS (colon-separated) overrides it.
GHOSTTY_DIRS="${THEME_GHOSTTY_DIRS-$HOME/Applications/Ghostty.app/Contents/Resources/ghostty/themes:/Applications/Ghostty.app/Contents/Resources/ghostty/themes:/usr/share/ghostty/themes:$HOME/.local/share/ghostty/themes}"
SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")" # absolute, for fzf callbacks
ESC=$'\033'
BEL=$'\007' # terminates OSC sequences
ST="${ESC}\\"
OUT_TTY=""
PANE_TTY=0                                          # 1 = OUT_TTY is this pane's own tty (wrap for tmux)

usage() {
  cat <<'EOF'
usage: theme <command> [--tty <path>] [--print] [--no-download]
  dark | light | auto      set the mode (auto = terminal profile, follows macOS) and apply it
  toggle                   flip between light and dark
  apply                    re-apply the saved mode (--no-download: fail fast if its theme is not cached or bundled)
  status                   print the mode and the light/dark picks (* = in use), plus the Neovim picks if set
  mode                     print only the saved mode: dark, light or auto (for scripts)
  effective                print the mode in effect: dark or light (auto resolved; for scripts)
  pick [slot]              choose a theme with fzf and live preview (default: the current mode's slot);
                           lists only themes of the slot's brightness, Ctrl-A toggles all themes;
                           the nvim slots start with the original Neovim themes of that brightness
  set <slot> <name>        save <name> in a slot, sync and apply
  set nvim-light|nvim-dark --clear
                           remove a Neovim pick, so Neovim follows the terminal again
                           slot: light | dark | nvim-light | nvim-dark (the nvim slots only change Neovim,
                           and alone accept the Neovim-only names, e.g. Cyberdream)
  list [light|dark]        print the available theme names; with an argument, only that brightness
  list nvim [light|dark]   print only the original Neovim themes (those with their own colorscheme)
  file <name>              print the path of a theme file (downloads it if needed;
                           --no-download: cache and Ghostty bundles only, fails fast offline)
  sync                     regenerate the Ghostty and iTerm files from ~/.config/theme/config
EOF
}

# Print an error and exit.
die() {
  echo "theme: $*" >&2
  exit 1
}

# --- Mode (per machine) ---

# Read the saved mode; a missing or unknown value means auto.
read_state() {
  local value=""
  [[ -r $STATE_FILE ]] && value="$(head -n 1 "$STATE_FILE")"
  case $value in
    dark | light) echo "$value" ;;
    *) echo auto ;;
  esac
}

# Save the mode, creating the directory if needed.
write_state() {
  mkdir -p "$(dirname "$STATE_FILE")"
  echo "$1" >"$STATE_FILE"
}

# Print the current macOS appearance (dark or light); non-macOS reports light.
system_appearance() {
  if [[ $(uname -s) == Darwin ]] &&
    [[ $(defaults read -g AppleInterfaceStyle 2>/dev/null || true) == Dark ]]; then
    echo dark
  else
    echo light
  fi
}

# Print the mode in effect: the saved choice, or the system appearance in auto.
effective_mode() {
  local state
  state="$(read_state)"
  if [[ $state == auto ]]; then system_appearance; else echo "$state"; fi
}

# --- Tracked config (~/.config/theme/config) ---

# Print the theme name for a key (light, dark, nvim_light or nvim_dark). light and dark fall
# back to their defaults; an unset nvim key prints nothing.
config_get() {
  local slot=$1 line name=""
  local re="^[[:space:]]*${slot}[[:space:]]*=[[:space:]]*(.*[^[:space:]])[[:space:]]*$"
  if [[ -r $CONFIG_FILE ]]; then
    while IFS= read -r line || [[ -n $line ]]; do # last line may lack a newline
      if [[ $line =~ $re ]]; then name="${BASH_REMATCH[1]}"; break; fi # first match wins
    done <"$CONFIG_FILE"
  fi
  if [[ -z $name ]]; then
    case $slot in
      light) name=$DEFAULT_LIGHT ;;
      dark) name=$DEFAULT_DARK ;;
    esac
  fi
  echo "$name"
}

# Replace (or add) the line for a slot, writing through the symlink so it stays a link.
config_set() {
  local slot=$1 name=$2 line out="" found=0
  local re="^[[:space:]]*${slot}[[:space:]]*="
  if [[ -e $CONFIG_FILE ]]; then
    while IFS= read -r line || [[ -n $line ]]; do   # keep comments and other lines as they are
      if ((!found)) && [[ $line =~ $re ]]; then
        line="$slot = $name"
        found=1
      fi
      out+="$line"$'\n'
    done <"$CONFIG_FILE"
  else
    mkdir -p "$(dirname "$CONFIG_FILE")"
  fi
  ((found)) || out+="$slot = $name"$'\n'
  printf '%s' "$out" >"$CONFIG_FILE"                # '>' follows a symlink: the repo file changes, the link stays
}

# Remove the line for a key; the other lines stay as they are.
config_unset() {
  local slot=$1 line out="" found=0
  local re="^[[:space:]]*${slot}[[:space:]]*="
  [[ -e $CONFIG_FILE ]] || return 0
  while IFS= read -r line || [[ -n $line ]]; do
    if ((!found)) && [[ $line =~ $re ]]; then found=1; continue; fi # first match, like config_get
    out+="$line"$'\n'
  done <"$CONFIG_FILE"
  printf '%s' "$out" >"$CONFIG_FILE"
}

# --- Theme files ---

# Exit with an error unless the name is safe to use as a file name.
check_name() {
  [[ -n $1 ]] || die "empty theme name"
  [[ $1 != */* && $1 != .* ]] || die "invalid theme name: $1" # no paths, no hidden files
}

# Print the original Neovim themes as "<name><TAB><colorscheme><TAB><light|dark>[<TAB>nvim]".
nvim_rows() {
  [[ -r $NVIM_LIST ]] || return 0
  grep -v -e '^[[:space:]]*#' -e '^[[:space:]]*$' "$NVIM_LIST" || true
}

# Succeed when the name is a Neovim-only theme: not in Ghostty's collection, so no terminal colors.
nvim_only() {
  nvim_rows | awk -F'\t' -v n="$1" '$1 == n && $4 == "nvim" { found = 1 } END { exit !found }'
}

# Print each bundled Ghostty themes directory that exists.
ghostty_dirs() {
  local dir
  local IFS=:
  for dir in $GHOSTTY_DIRS; do
    [[ -n $dir && -d $dir ]] && echo "$dir"
  done
  return 0 # no bundle is not an error
}

# Print the path of a theme inside a Ghostty bundle, or fail.
bundled_file() {
  local dir
  while IFS= read -r dir; do
    [[ -f "$dir/$1" ]] && { echo "$dir/$1"; return 0; }
  done < <(ghostty_dirs)
  return 1
}

# Percent-encode a string for a URL path (spaces, parentheses, plus signs...).
urlencode() {
  local LC_ALL=C s=$1 out="" c i
  for ((i = 0; i < ${#s}; i++)); do
    c="${s:i:1}"
    case $c in
      [A-Za-z0-9._~-]) out+=$c ;;
      *) out+="$(printf '%%%02X' "'$c")" ;;         # everything else becomes %XX
    esac
  done
  echo "$out"
}

# Download a theme into the cache, keeping only color lines (theme files can set any option).
download_theme() {
  local name=$1 dest="$CACHE_DIR/$1" tmp
  command -v curl >/dev/null 2>&1 || return 1
  mkdir -p "$CACHE_DIR"
  tmp="$(mktemp "$CACHE_DIR/.download.XXXXXX")" # partial file, never seen as a theme
  # --connect-timeout/--max-time: an unreachable network must not hang the shell or tmux
  if curl -fsSL --connect-timeout 3 --max-time 10 "$RAW_URL/$(urlencode "$name")" 2>/dev/null |
    grep -E '^[[:space:]]*(palette|background|foreground|cursor-color|cursor-text|selection-background|selection-foreground)[[:space:]]*=' >"$tmp" &&
    grep -q palette "$tmp"; then # a real theme has palette lines
    chmod 644 "$tmp" # mktemp files are private
    mv "$tmp" "$dest"
    return 0
  fi
  rm -f "$tmp"
  return 1
}

# Print the path of a theme file: Ghostty bundles (as sync_ghostty), then the cache, then a download.
theme_file() {
  local name=$1
  check_name "$name"
  if nvim_only "$name"; then
    echo "theme: '$name' is a Neovim-only theme: use it with nvim-light or nvim-dark" >&2
    return 1
  fi
  bundled_file "$name" && return 0 # same colors as Ghostty itself
  [[ -f "$CACHE_DIR/$name" ]] && { echo "$CACHE_DIR/$name"; return 0; }
  if ((NO_DOWNLOAD)); then
    echo "theme: '$name' is not cached or bundled (--no-download)" >&2
    return 1
  fi
  download_theme "$name" && { echo "$CACHE_DIR/$name"; return 0; }
  echo "theme: '$name' not found (no Ghostty bundle has it and the download failed; see 'theme list')" >&2
  return 1
}

# Print every theme name: Ghostty bundle (or GitHub, cached for a day) plus downloaded ones.
all_theme_names() {
  local dir file
  dir="$(ghostty_dirs | head -n 1)"
  {
    if [[ -n $dir ]]; then
      for file in "$dir"/*; do [[ -f $file ]] && echo "${file##*/}"; done
    else
      if [[ -z $(find "$LIST_CACHE" -mtime -1 2>/dev/null) ]]; then # missing or older than a day
        mkdir -p "$(dirname "$LIST_CACHE")"
        curl -fsSL --connect-timeout 3 --max-time 10 "$API_URL" 2>/dev/null |
          grep -o '"name": *"[^"]*"' |
          sed -e 's/^"name": *"//' -e 's/"$//' >"$LIST_CACHE.tmp" || true
        if [[ -s "$LIST_CACHE.tmp" ]]; then
          mv "$LIST_CACHE.tmp" "$LIST_CACHE"        # replace the cache only with a good list
        else
          rm -f "$LIST_CACHE.tmp"                   # offline: keep any older list
          [[ -s $LIST_CACHE ]] || echo "theme: no Ghostty bundle and the GitHub listing failed" >&2
        fi
      fi
      [[ -r $LIST_CACHE ]] && cat "$LIST_CACHE"
    fi
    if [[ -d $CACHE_DIR ]]; then
      for file in "$CACHE_DIR"/*; do [[ -f $file ]] && echo "${file##*/}"; done
    fi
    true                                            # an empty cache dir is not an error
  } | LC_ALL=C sort -u
}

# Print "<name><TAB><light|dark>" for each local theme file with a background color.
# The bundle wins over the download cache, like theme_file. Dark means perceived brightness
# (Rec. 601 luma of the encoded sRGB values, 0-1) below 0.5, which needs no gamma math.
classify_themes() {
  local dir d1 d2=$CACHE_DIR
  d1="$(ghostty_dirs | head -n 1)"
  # one grep and one awk for all files; -H tags each line with its path
  grep -s -H -E '^[[:space:]]*background[[:space:]]*=' "${d1:-/nonexistent}"/* "$d2"/* 2>/dev/null |
    awk -v d1="${d1:+$d1/}" -v d2="$d2/" '
      function hex(s,   i, v) {
        v = 0
        for (i = 1; i <= 2; i++) v = v * 16 + index("0123456789abcdef", substr(s, i, 1)) - 1
        return v
      }
      {
        rank = (d1 != "" && index($0, d1) == 1) ? 1 : (index($0, d2) == 1 ? 2 : 0)
        if (!rank) next
        pre = length(rank == 1 ? d1 : d2)
        if (!match($0, /:[[:space:]]*background[[:space:]]*=[[:space:]]*#?[0-9A-Fa-f]{6}/)) next
        name = substr($0, pre + 1, RSTART - pre - 1)
        val = tolower(substr($0, RSTART + RLENGTH - 6))
        if (name in best && best[name] < rank) next # the bundle keeps its own color
        best[name] = rank
        luma[name] = (0.299 * hex(substr(val, 1, 2)) + 0.587 * hex(substr(val, 3, 2)) + 0.114 * hex(substr(val, 5, 2))) / 255
      }
      END { for (n in luma) printf "%s\t%s\n", n, (luma[n] < 0.5 ? "dark" : "light") }'
}

# Print theme names, all of them or only the light or dark ones. Names without a local file
# or a background color cannot be classified, so they appear in both filtered lists.
list_themes() {
  local want=${1:-}
  case $want in
    "") all_theme_names ;;
    light | dark)
      awk -F'\t' -v want="$want" 'NR == FNR { cls[$1] = $2; next } !($0 in cls) || cls[$0] == want' \
        <(classify_themes) <(all_theme_names)
      ;;
    nvim | nvim-light | nvim-dark) # nvim [light|dark]; the dashed forms are the picker's
      local bright=${2:-}
      [[ $want == nvim ]] || bright=${want#nvim-}
      case $bright in light | dark | "") ;; *) die "usage: theme list nvim [light|dark]" ;; esac
      nvim_rows | awk -F'\t' -v want="$bright" 'want == "" || $3 == want { print $1 }'
      ;;
    *) die "usage: theme list [light|dark|nvim [light|dark]]" ;;
  esac
}

# --- Parsing and OSC sequences ---

# Read a theme file into T_PAL (0-15), T_BG, T_FG, T_CURSOR, T_CTEXT, T_SELBG, T_SELFG (hex, no #).
parse_theme() {
  local line key value
  local re_line='^[[:space:]]*([a-z-]+)[[:space:]]*=[[:space:]]*(.*)$'
  local re_pal='^([0-9]+)[[:space:]]*=[[:space:]]*#?([0-9A-Fa-f]{6})'
  local re_hex='^#?([0-9A-Fa-f]{6})'
  T_PAL=() T_BG="" T_FG="" T_CURSOR="" T_CTEXT="" T_SELBG="" T_SELFG=""
  while IFS= read -r line || [[ -n $line ]]; do
    [[ $line =~ $re_line ]] || continue
    key="${BASH_REMATCH[1]}" value="${BASH_REMATCH[2]}"
    if [[ $key == palette ]]; then
      [[ $value =~ $re_pal ]] && ((BASH_REMATCH[1] < 16)) &&
        T_PAL[BASH_REMATCH[1]]="${BASH_REMATCH[2]}"
      continue
    fi
    [[ $value =~ $re_hex ]] || continue
    value="${BASH_REMATCH[1]}"
    case $key in
      background) T_BG=$value ;;
      foreground) T_FG=$value ;;
      cursor-color) T_CURSOR=$value ;;
      cursor-text) T_CTEXT=$value ;;
      selection-background) T_SELBG=$value ;;
      selection-foreground) T_SELFG=$value ;;
    esac
  done <"$1"
  [[ -n $T_BG && -n $T_FG ]] || { echo "theme: $1 has no background/foreground" >&2; return 1; }
  : "${T_CURSOR:=$T_FG}" "${T_CTEXT:=$T_BG}"
  : "${T_SELFG:=$T_FG}"
  if [[ -z $T_SELBG ]]; then T_SELBG="${T_PAL[8]:-$T_FG}"; fi # fallback: bright black
}

# Print the OSC sequences for a theme name.
palette_sequences() {
  local file i
  file="$(theme_file "$1")" || return 1
  parse_theme "$file" || return 1
  for ((i = 0; i < 16; i++)); do
    [[ -n ${T_PAL[i]:-} ]] && printf '%s]4;%d;#%s%s\n' "$ESC" "$i" "${T_PAL[i]}" "$BEL" # OSC 4: palette color i
  done
  printf '%s]10;#%s%s\n' "$ESC" "$T_FG" "$BEL"      # OSC 10: foreground
  printf '%s]11;#%s%s\n' "$ESC" "$T_BG" "$BEL"      # OSC 11: background
  printf '%s]12;#%s%s\n' "$ESC" "$T_CURSOR" "$BEL"  # OSC 12: cursor
}

# Print the OSC resets: the terminal falls back to its own profile.
reset_sequences() {
  printf '%s]104%s\n' "$ESC" "$BEL"                 # OSC 104: reset the palette
  printf '%s]110%s\n' "$ESC" "$BEL"                 # OSC 110: reset foreground
  printf '%s]111%s\n' "$ESC" "$BEL"                 # OSC 111: reset background
  printf '%s]112%s\n' "$ESC" "$BEL"                 # OSC 112: reset cursor
}

# Copy sequences (one per line on stdin) to stdout, wrapped for tmux when needed.
emit_stdout() {
  local seq
  local wrap=0
  # Inside tmux, stdout and /dev/tty are the pane: wrap. A --tty client path bypasses tmux: raw.
  [[ -n ${TMUX:-} && (-z $OUT_TTY || $PANE_TTY == 1) ]] && wrap=1
  while IFS= read -r seq; do
    if ((wrap)); then
      printf '%sPtmux;%s%s' "$ESC" "${seq//$ESC/$ESC$ESC}" "$ST"  # DCS passthrough, ESC doubled
    else
      printf '%s' "$seq"
    fi
  done
}

# Send stdin sequences to the --tty target, or to stdout.
emit() {
  if [[ -n $OUT_TTY ]]; then
    emit_stdout >"$OUT_TTY"
  else
    emit_stdout
  fi
}

# Apply a mode: dark, light or auto.
apply_state() {
  local seqs                                        # sequences, built first so errors stop early
  case $1 in
    auto) seqs="$(reset_sequences)" ;;
    *) seqs="$(palette_sequences "$(config_get "$1")")" || return 1 ;;
  esac
  printf '%s\n' "$seqs" | emit
  if [[ -n ${TMUX:-} ]]; then
    tmux refresh-client -S 2>/dev/null || true
  fi
}

# --- Generated per-machine files ---

# Write ~/.config/ghostty/theme.conf (included by the tracked Ghostty config) and reload Ghostty.
sync_ghostty() {
  local light=$1 dark=$2 name file
  [[ -d $GHOSTTY_CONFIG_DIR ]] || return 0
  for name in "$light" "$dark"; do
    bundled_file "$name" >/dev/null && continue     # Ghostty already knows bundled themes
    file="$(theme_file "$name")" || return 1
    mkdir -p "$GHOSTTY_CONFIG_DIR/themes"           # Ghostty also searches ~/.config/ghostty/themes
    cp "$file" "$GHOSTTY_CONFIG_DIR/themes/$name"   # colors only (filtered on download)
  done
  rm -f "$GHOSTTY_CONFIG_DIR/theme.conf.tmp"        # leftover from a failed run
  {
    echo "# Generated by 'theme sync' from ~/.config/theme/config: do not edit."
    echo "theme = light:$light,dark:$dark"          # Ghostty switches with the system appearance
  } >"$GHOSTTY_CONFIG_DIR/theme.conf.tmp"
  rm -f "$GHOSTTY_CONFIG_DIR/theme.conf"            # drop a symlink if one is there
  mv "$GHOSTTY_CONFIG_DIR/theme.conf.tmp" "$GHOSTTY_CONFIG_DIR/theme.conf"
  echo "ghostty: $GHOSTTY_CONFIG_DIR/theme.conf" >&2
  # Ghostty reloads its config on SIGUSR2; THEME_NO_RELOAD=1 skips it.
  if [[ -z ${THEME_NO_RELOAD:-} ]] && pgrep -x ghostty >/dev/null 2>&1; then
    pkill -USR2 -x ghostty 2>/dev/null || true
  fi
}

# Print an iTerm color dictionary (JSON) for a hex color.
iterm_color() {
  local hex=$1
  awk -v r=$((16#${hex:0:2})) -v g=$((16#${hex:2:2})) -v b=$((16#${hex:4:2})) 'BEGIN {
    printf "{\"Color Space\":\"sRGB\",\"Red Component\":%.6f,\"Green Component\":%.6f,\"Blue Component\":%.6f,\"Alpha Component\":1}", r/255, g/255, b/255
  }'                                                # components are 0-1 floats
}

# Add every color key for one appearance (Light or Dark) from a theme file to a plist.
iterm_colors() {
  local plist=$1 suffix=$2 file=$3 i key hex
  parse_theme "$file" || return 1
  local -a keys=("Foreground Color" "Background Color" "Cursor Color" "Cursor Text Color"
    "Selection Color" "Selected Text Color" "Bold Color" "Link Color")
  local -a hexes=("$T_FG" "$T_BG" "$T_CURSOR" "$T_CTEXT" "$T_SELBG" "$T_SELFG" "$T_FG" "${T_PAL[4]:-$T_FG}")  # same order
  for ((i = 0; i < 16; i++)); do
    keys+=("Ansi $i Color")
    hexes+=("${T_PAL[i]:-$T_FG}")                   # missing entries fall back to fg
  done
  for i in "${!keys[@]}"; do
    key="${keys[i]} ($suffix)"
    hex="${hexes[i]}"
    plutil -replace "Profiles.0.$key" -json "$(iterm_color "$hex")" "$plist"
  done
}

# Generate the iTerm Dynamic Profile: tracked template + colors for both appearances.
sync_iterm() {
  local light_file=$1 dark_file=$2 tmp dir
  [[ $(uname -s) == Darwin && -f $ITERM_TEMPLATE ]] || return 0
  command -v plutil >/dev/null 2>&1 || return 0
  dir="$(dirname "$ITERM_PROFILE")"
  mkdir -p "$dir"
  tmp="$(mktemp "$dir/.dotfiles-iterm.XXXXXX")"  # same filesystem, hidden and no .plist: mv is one rename
  plutil -convert xml1 -o "$tmp" "$ITERM_TEMPLATE" # comments are dropped
  plutil -replace "Profiles.0.Use Separate Colors for Light and Dark Mode" -bool YES "$tmp"
  iterm_colors "$tmp" Light "$light_file" || { rm -f "$tmp"; return 1; }
  iterm_colors "$tmp" Dark "$dark_file" || { rm -f "$tmp"; return 1; }
  plutil -lint -s "$tmp" || { rm -f "$tmp"; return 1; }  # never install a broken profile
  chmod 644 "$tmp" # mktemp files are private
  mv "$tmp" "$ITERM_PROFILE" # atomic, replaces an old symlink: iTerm never sees a gap
  echo "iterm: $ITERM_PROFILE" >&2
}

# Regenerate every per-machine file from the tracked config.
sync_all() {
  local light dark light_file dark_file
  light="$(config_get light)" dark="$(config_get dark)"
  light_file="$(theme_file "$light")" || return 1
  dark_file="$(theme_file "$dark")" || return 1
  sync_ghostty "$light" "$dark" || return 1
  sync_iterm "$light_file" "$dark_file"
}

# Print the config key for a slot name, or fail: light, dark, nvim-light -> nvim_light, nvim-dark.
slot_key() {
  case $1 in
    light | dark) echo "$1" ;;
    nvim-light) echo nvim_light ;;
    nvim-dark) echo nvim_dark ;;
    *) return 1 ;;
  esac
}

# Save a theme in a slot. The terminal slots regenerate the files and apply the current mode;
# the nvim slots only write the config, since nothing but Neovim reads them.
set_theme() {
  local slot=$1 name=$2 key
  key="$(slot_key "$slot")" || die "slot must be light, dark, nvim-light or nvim-dark"
  if [[ $key == nvim_* ]] && nvim_only "$name"; then
    :                                               # no terminal file to check
  else
    theme_file "$name" >/dev/null || exit 1         # check (and fetch) before writing anything
  fi
  if [[ $key == nvim_* ]]; then
    config_set "$key" "$name"
    echo "$slot theme: $name (commit $CONFIG_FILE in your dotfiles repo to keep it)" >&2
    return 0
  fi
  config_set "$slot" "$name"
  echo "$slot theme: $name (commit $CONFIG_FILE in your dotfiles repo to keep it)" >&2
  sync_all || exit 1
  apply_state "$(read_state)"
}

# Remove a Neovim pick so Neovim follows the terminal theme in that mode again.
clear_nvim() {
  local key
  key="$(slot_key "$1")" || die "slot must be nvim-light or nvim-dark"
  [[ $key == nvim_* ]] || die "--clear only works on nvim-light or nvim-dark"
  config_unset "$key"
  echo "$1 theme cleared: Neovim follows the terminal (commit $CONFIG_FILE in your dotfiles repo to keep it)" >&2
}

# Print the mode and both picked themes, marking the one in use, then the Neovim picks if set.
status_report() {
  local state mode light dark lmark="" dmark="" nl nd
  state="$(read_state)"
  mode="$(effective_mode)"
  light="$(config_get light)" dark="$(config_get dark)"
  if [[ $state == auto ]]; then state="auto ($mode now)"; fi
  if [[ $mode == light ]]; then lmark="  *"; else dmark="  *"; fi
  printf 'mode:  %s\nlight: %s%s\ndark:  %s%s\n' "$state" "$light" "$lmark" "$dark" "$dmark"
  nl="$(config_get nvim_light)" nd="$(config_get nvim_dark)"
  [[ -z $nl ]] || printf 'nvim light: %s\n' "$nl"
  [[ -z $nd ]] || printf 'nvim dark:  %s\n' "$nd"
}

# --- Picker (fzf) ---

# Print a preview of a theme: the 16 colors as blocks and sample text on its background.
swatch() {
  local file cols i
  if nvim_only "$1"; then
    printf '%s\n\nNeovim only: the terminal cannot preview this theme.\nEnter saves it; see it in Neovim.\n' "$1"
    return 0
  fi
  file="$(theme_file "$1")" || return 0             # fzf shows the error text
  parse_theme "$file" || return 0
  cols=${FZF_PREVIEW_COLUMNS:-60}
  rgb() { printf '%d;%d;%d' $((16#${1:0:2})) $((16#${1:2:2})) $((16#${1:4:2})); }
  printf '%s\n\n' "$1"
  for row in 0 8; do
    for ((i = row; i < row + 8; i++)); do
      printf '%s[48;2;%sm %2d  %s[0m' "$ESC" "$(rgb "${T_PAL[i]:-$T_BG}")" "$i" "$ESC"
    done
    printf '\n'
  done
  printf '\n'
  # sample_line color text color text ...: colored segments on the theme background, padded.
  sample_line() {
    local len=0 bg
    bg="${ESC}[48;2;$(rgb "$T_BG")m"
    printf '%s' "$bg"
    while (($# >= 2)); do
      printf '%s[38;2;%sm%s' "$ESC" "$(rgb "$1")" "$2"
      len=$((len + ${#2}))
      shift 2
    done
    printf '%*s%s[0m\n' $((cols > len ? cols - len : 0)) "" "$ESC" # pad to the pane width
  }
  local p0=${T_PAL[0]:-$T_FG} p1=${T_PAL[1]:-$T_FG} p2=${T_PAL[2]:-$T_FG} p3=${T_PAL[3]:-$T_FG}
  local p4=${T_PAL[4]:-$T_FG} p5=${T_PAL[5]:-$T_FG} p6=${T_PAL[6]:-$T_FG} p8=${T_PAL[8]:-$T_FG}
  sample_line "$T_FG" ""
  sample_line "$p8" "  // greet prints a friendly message"
  sample_line "$p5" "  func " "$p4" "greet" "$T_FG" "(name " "$p6" "string" "$T_FG" ") {"
  sample_line "$T_FG" "    fmt.Println(" "$p2" "\"hello, \"" "$T_FG" " + name)"
  sample_line "$T_FG" "    count := " "$p3" "42" "$T_FG" " " "$p8" "// number"
  sample_line "$T_FG" "  }"
  sample_line "$T_FG" ""
  sample_line "$p1" "  error " "$p3" " warning " "$p2" " ok " "$p6" " info " "$p0" " black"
  sample_line "$T_FG" ""
  printf '\n%s[48;2;%sm%s[38;2;%sm selected text %s[0m ' "$ESC" "$(rgb "$T_SELBG")" "$ESC" "$(rgb "$T_SELFG")" "$ESC"
  printf '%s[48;2;%sm%s[38;2;%sm cursor %s[0m\n' "$ESC" "$(rgb "$T_CURSOR")" "$ESC" "$(rgb "$T_CTEXT")" "$ESC"
}

# Apply a theme to the terminal fzf runs in (fzf callbacks have no tty on stdout).
preview_apply() {
  ! nvim_only "$1" || return 0                      # no terminal colors: leave the terminal as it is
  OUT_TTY=/dev/tty PANE_TTY=1
  palette_sequences "$1" 2>/dev/null | emit || true # ignore unknown names while scrolling
}

# Print the brightness a slot's themes have: light or dark (nvim slots follow their terminal slot).
slot_brightness() {
  case $1 in
    light | nvim-light) echo light ;;
    dark | nvim-dark) echo dark ;;
  esac
}

# Print the list filter a slot starts with: its brightness, or nvim-<brightness> for the nvim slots.
slot_filter() {
  case $1 in nvim-*) echo "nvim-$2" ;; *) echo "$2" ;; esac
}

# fzf callbacks for the picker. The state file holds "filtered" or "all"; THEME_PICK_CURRENT is the saved theme.
# Print the picker header for the state file's mode.
pick_header() {
  local statefile=$1 slot=$2 bright=$3 mode
  local only="$bright only"
  [[ $slot == nvim-* ]] && only="original Neovim $bright themes"
  mode="$only (ctrl-a: all)"
  [[ $(cat "$statefile") == all ]] && mode="all themes (ctrl-a: back)"
  echo "Enter: save as the $slot theme   Esc: cancel   $mode"
}

# Print the fzf actions that apply the state file's mode: reload the list, retitle the header.
pick_mode_actions() {
  local statefile=$1 filter
  filter="$(slot_filter "$2" "$3")"
  [[ $(cat "$statefile") == all ]] && filter=""
  printf 'reload(%s _list %s)+change-header(%s)' "$(printf '%q' "$SELF")" "$filter" "$(pick_header "$@")"
}

# Flip the state file between filtered and all, then print the actions.
pick_toggle() {
  local statefile=$1
  if [[ $(cat "$statefile") == all ]]; then echo filtered >"$statefile"; else echo all >"$statefile"; fi
  pick_mode_actions "$@"
}

# Print the fzf action that puts the cursor on the current theme in the file's mode.
pick_position() {
  local statefile=$1 filter="" pos
  [[ $(cat "$statefile") == all ]] || filter="$(slot_filter "$2" "$3")"
  pos="$(list_themes "$filter" | grep -nxF -- "${THEME_PICK_CURRENT:-}" | cut -d: -f1 || true)"
  echo "pos(${pos:-1})"
}

# Choose a theme with fzf: live preview on focus, Enter saves, Esc restores.
# Starts on the slot's brightness; Ctrl-A switches to all themes and back.
pick() {
  local slot=${1:-} self list choice key current bright statefile
  [[ -n $slot ]] || slot="$(effective_mode)"
  key="$(slot_key "$slot")" || die "usage: theme pick [light|dark|nvim-light|nvim-dark]"
  command -v fzf >/dev/null 2>&1 || die "fzf not found: use 'theme set $slot <name>' (see 'theme list')"
  bright="$(slot_brightness "$slot")"
  current="$(config_get "$key")"
  [[ -n $current ]] || current="$(config_get "${key#nvim_}")" # an unset nvim pick follows the terminal
  statefile="$(mktemp)"
  list="$(list_themes "$(slot_filter "$slot" "$bright")")"
  # the current theme must be visible: otherwise start on the full list
  if printf '%s\n' "$list" | grep -qxF -- "$current"; then echo filtered >"$statefile"; else echo all >"$statefile"; fi
  [[ -n $list ]] || die "no themes found"
  export THEME_PICK_CURRENT="$current"
  self="$(printf '%q' "$SELF")"                     # quoted for fzf's shell
  local qstate
  qstate="$(printf '%q' "$statefile")"
  choice="$("$SELF" _list "$([[ $(cat "$statefile") == all ]] || slot_filter "$slot" "$bright")" | fzf \
    --prompt="$slot theme> " \
    --header="$(pick_header "$statefile" "$slot" "$bright")" \
    --preview="$self _swatch {}" \
    --preview-window=right,60% \
    --bind="focus:execute-silent($self _preview {})" \
    --bind="ctrl-a:transform($self _toggle $qstate $slot $bright)" \
    --bind="load:transform($self _pos $qstate $slot $bright)")" || true # Esc or Ctrl-C: empty choice
  rm -f "$statefile"
  if [[ -z $choice ]]; then
    OUT_TTY=/dev/tty PANE_TTY=1                     # restore on the same tty the preview used
    apply_state "$(read_state)"
    return 0
  fi
  set_theme "$slot" "$choice"
  if [[ $key == nvim_* ]]; then
    OUT_TTY=/dev/tty PANE_TTY=1                     # the preview recolored the terminal: undo it
    apply_state "$(read_state)"
  fi
}

# --- Arguments ---
CMD=""
ARGS=()
PRINT=0
NO_DOWNLOAD=0
while (($#)); do
  case $1 in
    --tty) OUT_TTY="${2:?--tty needs a path}"; shift 2 ;;
    --print) PRINT=1; shift ;; # the default
    --no-download) NO_DOWNLOAD=1; shift ;; # cache and bundles only
    -h | --help) CMD=help; shift ;;
    *)
      if [[ -z $CMD ]]; then CMD=$1; else ARGS+=("$1"); fi
      shift
      ;;
  esac
done
((PRINT)) && OUT_TTY=""                             # --print wins over --tty
# Bash 3.2 treats an empty array as unset under `set -u`; these give safe defaults.
ARG1="${ARGS[0]:-}"
ARG2="${ARGS[1]:-}"
if ((${#ARGS[@]} > 2)); then ARG2="${ARGS[*]:1}"; fi  # unquoted names with spaces: join the words

# Log only runs a person starts (keys, tt); apply, status and the rest run by themselves.
case $CMD in dark | light | auto | toggle | pick | set) "$(dirname "$0")/dotfiles-log" theme >/dev/null 2>&1 || true ;; esac

case $CMD in
  dark | light | auto)
    apply_state "$CMD"                              # show it first: a failed apply must not change the saved mode
    write_state "$CMD"
    ;;
  apply) apply_state "$(read_state)" ;;
  status) status_report ;;
  mode) read_state ;;                               # one word, stable for parsers
  effective) effective_mode ;;
  toggle)
    case $(read_state) in
      dark) new=light ;;
      light) new=dark ;;
      *) if [[ $(system_appearance) == dark ]]; then new=light; else new=dark; fi ;;  # auto: opposite of macOS
    esac
    apply_state "$new"                              # show it first: a failed apply must not change the saved mode
    write_state "$new"
    ;;
  pick) pick "$ARG1" ;;
  set)
    [[ -n $ARG1 && -n $ARG2 ]] || die "usage: theme set light|dark|nvim-light|nvim-dark <name> | theme set nvim-light|nvim-dark --clear"
    if [[ $ARG2 == --clear ]]; then clear_nvim "$ARG1"; else set_theme "$ARG1" "$ARG2"; fi
    ;;
  list) list_themes "$ARG1" "$ARG2" ;;
  file)
    [[ -n $ARG1 ]] || die "usage: theme file <name>"
    theme_file "${ARGS[*]}"                         # path (joined, so quotes are optional)
    ;;
  sync) sync_all ;;
  _swatch) swatch "$ARG1" ;; # internal: fzf preview
  _preview) preview_apply "$ARG1" ;; # internal: fzf focus callback
  _list) list_themes "$ARG1" ;; # internal: fzf reload source
  _toggle) pick_toggle "${ARGS[@]}" ;; # internal: fzf ctrl-a
  _pos) pick_position "${ARGS[@]}" ;; # internal: fzf load
  help) usage ;;
  *)
    usage >&2
    exit 2
    ;;
esac
