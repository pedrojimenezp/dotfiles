#!/usr/bin/env bash
# Pick a project directory or git worktree with fzf and open (or switch to) a tmux session for it.
# Usage: tmux-sessionizer [dir]   (without an argument, pick from the configured roots; see docs/tmux-sessionizer.md)
#        tmux-sessionizer --list  (print the candidates as "label<TAB>path<TAB>repo" and exit)
# Default roots: ~/projects if it exists (depth 3), else $HOME (depth 2, skipping go, snap, bin).
# Per-machine settings: ${XDG_CONFIG_HOME:-~/.config}/sessionizer/config (see docs/tmux-sessionizer.md).
# Env vars: SESSIONIZER_DIRS, SESSIONIZER_EXCLUDE, SESSIONIZER_DEPTH override the file.
# Worktrees are named after their branch; other directories after their basename.
# SESSIONIZER_TMUX_ARGS adds tmux options, e.g. "-L sock" for a separate server.
set -euo pipefail # stop on errors, unset variables and failed pipes

# Settings: env vars > config file > built-in defaults.
# Config file lines are "key = value" (include, exclude, depth); values are space-separated paths.
config_file="${XDG_CONFIG_HOME:-$HOME/.config}/sessionizer/config" # per machine, not tracked in the repo
cfg_include="" cfg_exclude="" cfg_depth="" # stay empty when the file does not set them

warn() { printf 'tmux-sessionizer: %s\n' "$*" >&2; } # stderr keeps --list output clean

# Expand a leading ~, $HOME or ${HOME} by hand; eval would run anything written in the file.
# shellcheck disable=SC2016,SC2088 # the patterns match the literal text ~ and $HOME
expand_path() {
  case "$1" in
    "~") printf '%s' "$HOME" ;;                      # bare tilde
    "~/"*) printf '%s' "$HOME/${1#"~/"}" ;;          # tilde prefix
    '$HOME') printf '%s' "$HOME" ;;                  # bare variable
    '$HOME/'*) printf '%s' "$HOME/${1#'$HOME/'}" ;;  # variable prefix
    '${HOME}') printf '%s' "$HOME" ;;                # braced variable
    '${HOME}/'*) printf '%s' "$HOME/${1#'${HOME}/'}" ;; # braced prefix
    *) printf '%s' "$1" ;;                           # anything else is used as written
  esac
}

# Print the expanded, space-separated form of a list of paths.
expand_list() {
  local words=() w out="" # words holds the split input
  read -r -a words <<<"$1" # split on whitespace without globbing
  for w in ${words[@]+"${words[@]}"}; do out+="${out:+ }$(expand_path "$w")"; done # join the expanded paths
  printf '%s' "$out"
}

# Whitespace trimming with parameter expansion only (no external commands).
trim() {
  local s="$1" # value to trim
  s="${s#"${s%%[![:space:]]*}"}" # drop leading blanks
  s="${s%"${s##*[![:space:]]}"}" # drop trailing blanks
  printf '%s' "$s"
}

if [[ -f "$config_file" ]]; then
  while IFS= read -r line || [[ -n "$line" ]]; do # last line may lack a newline
    line="$(trim "${line%%#*}")" # strip comments and blanks
    [[ -n "$line" ]] || continue # empty or comment-only line
    if [[ "$line" != *=* ]]; then warn "$config_file: ignoring line without '=': $line"; continue; fi # not key = value
    key="$(trim "${line%%=*}")" val="$(trim "${line#*=}")" # split at the first =
    case "$key" in
      include) cfg_include="$(expand_list "$val")" ;; # replaces the default roots
      exclude) cfg_exclude="$(expand_list "$val")" ;; # trees to skip
      depth) cfg_depth="$val" ;;                      # validated below with the env var
      *) warn "$config_file: unknown key '$key' (ignored)" ;; # typo guard
    esac
  done <"$config_file"
fi

# Roots to search. SESSIONIZER_DIRS > include > ~/projects > $HOME.
depth_default=3 # how deep find looks under each root
fallback=0 # 1 when searching $HOME because nothing else is set
include="$(expand_list "${SESSIONIZER_DIRS:-$cfg_include}")" # explicit roots keep the default depth
roots=() # only roots that exist
if [[ -n "$include" ]]; then
  read -r -a wanted <<<"$include" # one entry per root
  for d in ${wanted[@]+"${wanted[@]}"}; do
    if [[ -d "$d" ]]; then roots+=("$d"); fi # missing roots are skipped silently
  done
elif [[ -d "$HOME/projects" ]]; then
  roots=("$HOME/projects") # the usual layout
else
  roots=("$HOME") # servers often keep repos directly in $HOME
  depth_default=2 # repos sit at depth 1 or 2 (e.g. ~/development/app); deeper is noise
  fallback=1 # enables the built-in prunes below
fi

depth="$depth_default" # may be overridden below
want_depth="${SESSIONIZER_DEPTH:-$cfg_depth}" # env wins over the file
if [[ -n "$want_depth" ]]; then
  if [[ "$want_depth" =~ ^[1-9][0-9]*$ ]]; then depth="$want_depth"; else warn "bad depth '$want_depth' (use a number >= 1); using $depth_default"; fi # find needs a positive integer
fi

prune=() # trees find must not enter (it would walk huge caches such as go/pkg/mod)
add_prune() { if ((${#prune[@]})); then prune+=(-o); fi; prune+=(-path "${1%/}"); } # find ORs the tests together
if ((fallback)); then
  add_prune "$HOME/go"; add_prune "$HOME/snap"; add_prune "$HOME/bin" # not projects (worktrees folders are pruned by name in the find below)
fi
read -r -a excluded <<<"$(expand_list "${SESSIONIZER_EXCLUDE:-$cfg_exclude}")" # env replaces the file's list
for d in ${excluded[@]+"${excluded[@]}"}; do add_prune "$d"; done # added on top of the built-in prunes
read -r -a tmux_args <<<"${SESSIONIZER_TMUX_ARGS:-}" # extra tmux options (empty by default)

tm() { tmux ${tmux_args[@]+"${tmux_args[@]}"} "$@"; } # one place to add tmux options

# Print "branch  [repo]<TAB>path<TAB>repo" for each linked worktree of a repo.
worktrees_of() {
  local repo="$1" repo_name line path="" branch="" skip=0 first=1
  repo_name="$(basename "$repo")" # shown next to the branch to tell repos apart
  while IFS= read -r line; do
    case "$line" in
      "worktree "*) path="${line#worktree }" ;;                # start of an entry
      "branch "*) branch="${line#branch refs/heads/}" ;;       # detached entries have none
      bare | prunable*) skip=1 ;;                              # nothing usable to open
      "") # blank line ends an entry
        if [[ -n "$path" ]]; then
          if ((first)); then
            first=0 # the first entry is the main checkout, already in the plain list
          elif ((!skip)) && [[ -d "$path" ]]; then
            printf '%s  [%s]\t%s\t%s\n' "${branch:-$(basename "$path")}" "$repo_name" "$path" "$repo_name"
          fi
        fi
        path="" branch="" skip=0 ;; # reset for the next entry
    esac
  done < <(git -C "$repo" worktree list --porcelain 2>/dev/null || true; echo) # trailing echo closes the last entry
}

# True when path $1 is already a path field in the worktree rows $2 (also compares the physical path).
is_listed() {
  local p="$1" rows="$2" phys
  [[ "$rows" == *$'\t'"$p"$'\t'* ]] && return 0 # git prints physical paths, find prints them as written under the root
  phys="$(CDPATH= cd -- "$p" 2>/dev/null && pwd -P)" || return 1
  [[ "$rows" == *$'\t'"$phys"$'\t'* ]]
}

# Print all candidates: worktrees first (what you are usually working on), then plain dirs.
list_candidates() {
  local dirs d gl wts="" plain="" linked=() # wts and plain collect output so worktrees can print first
  local prune_expr=() # find expression that skips the pruned trees without descending
  if ((${#prune[@]})); then prune_expr=(\( "${prune[@]}" \) -prune -o); fi # empty when nothing to skip
  if ((${#roots[@]} == 0)); then return 0; fi # find with no path would search the current directory
  # Hidden dirs, .git, node_modules and worktrees are pruned (not walked); linked worktrees come from git instead.
  # -mindepth 1 keeps the tests off the roots themselves, so a hidden root still works.
  # -H follows the roots only, so a root that is a symlink is still searched.
  dirs="$(find -H "${roots[@]}" -mindepth 1 -maxdepth "$depth" ${prune_expr[@]+"${prune_expr[@]}"} \
    \( -name '.*' -o -name node_modules -o -name worktrees \) -prune -o -type d -print 2>/dev/null || true)"
  while IFS= read -r d; do
    [[ -n "$d" ]] || continue # find printed nothing
    if [[ -f "$d/.git" ]]; then
      IFS= read -r gl <"$d/.git" || true # "gitdir: <path>": linked worktrees point into .../worktrees/<name>, submodules into .../modules/<name>
      if [[ "$gl" == */worktrees/* ]]; then linked+=("$d"$'\t'"${gl#gitdir: }"); continue; fi # checked below, once every repo has been asked
    fi
    plain+="$d"$'\t'"$d"$'\t\n' # label and path are the same for plain dirs
    # Only main checkouts have a .git directory (submodules and linked worktrees have a file), so git runs once per repo.
    if [[ -d "$d/.git" ]]; then wts+="$(worktrees_of "$d")"$'\n'; fi
  done <<<"$dirs"
  # A linked worktree is listed from its repo. If that repo was not walked (outside the roots, hidden, bare,
  # too deep), no repo listed it: add it here, with its own branch.
  local entry gitdir common branch repo_name
  for entry in ${linked[@]+"${linked[@]}"}; do
    d="${entry%%$'\t'*}" gitdir="${entry#*$'\t'}"
    if is_listed "$d" "$wts"; then continue; fi
    common="${gitdir%/worktrees/*}" # the shared git dir (.git or .bare)
    repo_name="$(basename "$(dirname "$common")")" # same rule as the session naming below
    branch="$(git -C "$d" branch --show-current 2>/dev/null || true)"
    wts+="${branch:-$(basename "$d")}  [$repo_name]"$'\t'"$d"$'\t'"$repo_name"$'\n'
  done
  printf '%s\n' "$wts" | sed '/^$/d' # drop blank lines left by repos without worktrees
  printf '%s' "$plain"
}

repo=""
if [[ "${1:-}" == "--list" ]]; then
  list_candidates
  exit 0
elif [[ $# -eq 1 ]]; then
  [[ -d "$1" ]] || { warn "not a directory: $1"; exit 1; }
  selected="$(cd "$1" && pwd -P)" # absolute and symlink-free, so names and the path check agree ('.' would be named '-')
else
  line="$(list_candidates | fzf --prompt='project> ' --delimiter=$'\t' --with-nth=1 || true)" # show only the label
  [[ -n "$line" ]] || exit 0 # nothing chosen (Esc)
  IFS=$'\t' read -r _ selected repo <<<"$line" # hidden columns: path and repo
  selected="$(cd "$selected" && pwd -P)" # physical path too, so it compares equal to the session paths below
fi

[[ -n "$selected" ]] || exit 0 # empty argument
# A linked worktree (its git dir differs from the shared one) is named by branch, repo = main folder,
# whichever way it was chosen.
gd="$(git -C "$selected" rev-parse --path-format=absolute --git-dir 2>/dev/null || true)"
cd_="$(git -C "$selected" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
if [[ -n "$gd" && -n "$cd_" && "$gd" != "$cd_" ]]; then repo="$(basename "$(dirname "$cd_")")"; fi
"$(dirname "$0")/dotfiles-log" tmux-sessionizer >/dev/null 2>&1 || true # count the run for dotfiles-usage

if [[ -n "$repo" ]]; then
  name="$(git -C "$selected" branch --show-current 2>/dev/null || true)" # worktree: named after its branch
  name="${name:-$(basename "$selected")}" # detached HEAD falls back to the folder name
else
  name="$(basename "$selected")"
fi
name="$(printf '%s' "$name" | tr './: ' '----' | tr -s '-')" # tmux rejects dots and colons; slashes would read as paths; collapse repeated dashes

# Physical start directory of the session named $1; empty when there is none.
session_dir() {
  local p
  p="$(tm list-sessions -F '#{session_name}'$'\t''#{session_path}' 2>/dev/null | awk -F'\t' -v n="$1" '$1 == n { print $2; exit }' || true)" # where that session was started
  if [[ -d "$p" ]]; then p="$(cd "$p" && pwd -P)"; fi # sessions made elsewhere may hold /var vs /private/var spellings
  printf '%s' "$p"
}

# Name of a session already started in physical directory $1; empty when there is none.
session_for_path() {
  local n p
  while IFS=$'\t' read -r n p; do
    if [[ -d "$p" ]]; then p="$(cd "$p" && pwd -P)"; fi # same spelling fix as session_dir
    if [[ "$p" == "$1" ]]; then printf '%s' "$n"; return 0; fi
  done < <(tm list-sessions -F '#{session_name}'$'\t''#{session_path}' 2>/dev/null || true)
}

# Reuse the session already started in this directory, whatever its name (it may have got a suffix
# earlier). Otherwise a same-named session for another directory would be switched to by mistake:
# add the repo (worktrees) or the parent folder (plain dirs) to tell them apart, then a counter if
# that name is taken too.
found="$(session_for_path "$selected")"
existing="$(session_dir "$name")"
if [[ -n "$found" ]]; then
  name="$found"
elif [[ -n "$existing" && "$existing" != "$selected" ]]; then
  extra="${repo:-$(basename "$(dirname "$selected")")}" # the repo for worktrees, else the folder that holds the directory
  name="$name-$(printf '%s' "$extra" | tr './: ' '----' | tr -s '-')" # same cleanup as the name above
  base="$name" n=2
  while existing="$(session_dir "$name")"; [[ -n "$existing" && "$existing" != "$selected" ]]; do
    name="$base-$n" n=$((n + 1)) # -2, -3, ... until the name is free or ours
  done
fi

if [[ -z "${TMUX:-}" ]]; then
  # Outside tmux: attach to the session, creating it if needed.
  tm new-session -A -s "$name" -c "$selected"
else
  # Inside tmux: create the session detached if missing, then switch to it.
  tm has-session -t "=$name" 2>/dev/null || tm new-session -ds "$name" -c "$selected"
  tm switch-client -t "=$name"
fi
