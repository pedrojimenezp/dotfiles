#!/usr/bin/env bash
# Pick a project folder or feature worktree with fzf and open (or switch to) a tmux session for it.
# Usage: tmux-sessionizer [--name <name>] [dir]   (without a dir, pick from the roots; see docs/tmux.md)
#        tmux-sessionizer --list  (print "label<TAB>path" for each candidate and exit)
# --name <name>: open a new session with exactly that name (cleaned like a folder name) in the chosen folder,
# even when another session already uses it; an existing session with that name is switched to, not recreated.
# Candidates, in order: features, repos, the home folder (~), then zoxide's folders (when zoxide exists) not already listed.
# In the picker, a typed path (starting with / or ~, a leading ~ is expanded) that is an existing folder
# wins over the selected row; any other query uses the selected row, else the typed text as a path.
# Folder convention: <repo>/worktrees/<branch> or <parent>/worktrees/<feature>/<project>;
# any <x>/worktrees/<feature> is a feature session. No git calls.
# Roots: SESSIONIZER_DIRS (space separated) if set; otherwise ~/projects (deep search) plus the repos
# directly in ~ (and their worktrees/). Repos deeper in ~ need SESSIONIZER_DIRS.
# SESSIONIZER_TMUX_ARGS adds tmux options, e.g. "-L sock" for a separate server.
set -euo pipefail

# A popup may start without the Homebrew, user or mise paths.
# Adds the existing folders that are not in PATH yet.
for d in /usr/local/bin /opt/homebrew/bin "$HOME/.local/bin" "$HOME/.local/share/mise/shims"; do
  [[ ":$PATH:" == *":$d:"* || ! -d "$d" ]] || PATH="$d:$PATH" # each added folder goes first, so the last in this list wins
done
export PATH

read -r -a tmux_args <<<"${SESSIONIZER_TMUX_ARGS:-}"
tm() { tmux ${tmux_args[@]+"${tmux_args[@]}"} "$@"; }
clean() { printf '%s' "$1" | tr './: ' '----' | tr -s '-'; } # tmux rejects dots and colons

roots=()
home_repos=1 # also list the repos directly in $HOME (default roots only)
if [[ -n "${SESSIONIZER_DIRS:-}" ]]; then
  home_repos=0
  for d in $SESSIONIZER_DIRS; do [[ -d "$d" ]] && roots+=("$d"); done
elif [[ -d "$HOME/projects" ]]; then
  roots=("$HOME/projects")
fi

# Features first (<x>/worktrees/<feature>, label "feature  [x]"), then repos (a folder with .git, label = path).
# One find: prune hidden dirs and node_modules, print worktrees/ folders and .git entries without entering them.
list_candidates() {
  local p d f w feats="" repos=""
  add_features() { # $1 = a worktrees/ folder
    for f in "$1"/*/; do
      [[ -d "$f" ]] || continue # an empty worktrees/ leaves the glob unexpanded
      f="${f%/}"
      w="${1%/*}"
      feats+="${f##*/}  [${w##*/}]"$'\t'"$f"$'\n'
    done
  }
  if ((${#roots[@]})); then # find with no path would search the current directory
    while IFS= read -r p; do
      if [[ "$p" == */worktrees ]]; then
        add_features "$p"
      else
        d="${p%/.git}"
        repos+="$d"$'\t'"$d"$'\n'
      fi
    done < <(find -H "${roots[@]}" -mindepth 1 -maxdepth 4 \
      \( \( -name '.*' ! -name .git \) -o -name node_modules \) -prune -o \
      \( -name worktrees -type d -print -prune \) -o \( -name .git -print -prune \) 2>/dev/null || true)
  fi
  if ((home_repos)); then # glob skips hidden names
    for d in "$HOME"/*/; do
      d="${d%/}"
      [[ -e "$d/.git" ]] || continue
      repos+="$d"$'\t'"$d"$'\n'
      if [[ -d "$d/worktrees" ]]; then add_features "$d/worktrees"; fi
    done
  fi
  local known=$'\n' z label zoxide_rows="" # known: the listed paths, one per line, to skip duplicates
  while IFS=$'\t' read -r _ p; do if [[ -n "$p" ]]; then known+="$p"$'\n'; fi; done <<<"$feats$repos"
  local home_row=""
  if [[ "$known" != *$'\n'"$HOME"$'\n'* ]]; then # the home folder is always a candidate
    known+="$HOME"$'\n'
    home_row="~"$'\t'"$HOME"$'\n'
  fi
  if command -v zoxide >/dev/null 2>&1; then
    while IFS= read -r z; do
      [[ -d "$z" && "$known" != *$'\n'"$z"$'\n'* ]] || continue
      known+="$z"$'\n'
      label="$z"
      [[ "$z" == "$HOME" || "$z" == "$HOME"/* ]] && label="~${z#"$HOME"}"
      zoxide_rows+="$label"$'\t'"$z"$'\n'
    done < <(zoxide query -l 2>/dev/null || true)
  fi
  printf '%s%s%s%s' "$feats" "$repos" "$home_row" "$zoxide_rows"
}

# Tells the user that a typed path is not a folder: a tmux message inside tmux, stderr otherwise.
no_such_folder() {
  if [[ -n "${TMUX:-}" ]]; then tm display-message "no such folder: $1"; else echo "no such folder: $1" >&2; fi
}

if [[ "${1:-}" == "--list" ]]; then
  list_candidates
  exit 0
fi

custom_name="" # set by --name
if [[ "${1:-}" == "--name" ]]; then
  custom_name="$(clean "${2:-}")"
  [[ "$custom_name" != - ]] || custom_name="" # a name of only separators is empty
  [[ -n "$custom_name" ]] || exit 0
  shift 2
fi

if [[ $# -eq 1 ]]; then
  selected="$(CDPATH='' cd -- "$1" && pwd -P)" # absolute and symlink-free, so '.' is not named '-'
else
  # --print-query prints the typed query first, then the selected line (if any). {2} is the path field.
  prompt='project> '
  [[ -z "$custom_name" ]] || prompt="folder for $custom_name> "
  out="$(list_candidates | fzf --print-query --prompt="$prompt" --delimiter=$'\t' --with-nth=1 \
    --header='Enter: pick | type a folder path (/... or ~...) to use it | Esc: cancel' \
    --preview='ls -1Ap {2} 2>/dev/null | head -50' --preview-window=right:40% || true)"
  query="$(sed -n 1p <<<"$out")"
  line="$(sed -n 2p <<<"$out")"
  chosen="$query"
  tilde='~' # a typed ~ is not expanded by the shell
  if [[ "$chosen" == "$tilde" ]]; then
    chosen="$HOME"
  elif [[ "$chosen" == "$tilde"/* ]]; then
    chosen="$HOME/${chosen#"$tilde"/}"
  fi
  if [[ "$query" == [/~]* && -d "$chosen" ]]; then
    : # a typed folder beats the selected row
  elif [[ -n "$line" ]]; then
    chosen="${line#*$'\t'}"
  else
    [[ -n "$chosen" ]] || exit 0
    [[ -d "$chosen" ]] || { no_such_folder "$chosen"; exit 0; }
  fi
  selected="$(CDPATH='' cd -- "$chosen" && pwd -P)"
fi
"$(dirname "$0")/dotfiles-log" tmux-sessionizer >/dev/null 2>&1 || true

parent="$(dirname "$selected")"
name="$(clean "$(basename "$selected")")"
if [[ "$(basename "$parent")" == worktrees ]]; then
  extra="$(basename "$(dirname "$parent")")" # the repo or parent folder that owns worktrees/
else
  extra="$(basename "$parent")"
fi

# --name: the name is final, with no folder lookup and no suffix.
# Otherwise reuse a session already started in this folder; popup sessions share the path, never switch into one.
found=""
if [[ -z "$custom_name" ]]; then
  found="$(tm list-sessions -F '#{session_name}'$'\t''#{session_path}' 2>/dev/null |
    awk -F'\t' -v p="$selected" '$1 !~ /^_popup_/ && $2 == p { print $1; exit }' || true)"
fi
if [[ -n "$custom_name" ]]; then
  name="$custom_name"
  if tm has-session -t "=$name" 2>/dev/null; then
    if [[ -n "${TMUX:-}" ]]; then tm display-message "session $name already exists"; else echo "session $name already exists" >&2; fi
  fi
elif [[ -n "$found" ]]; then
  name="$found"
elif tm has-session -t "=$name" 2>/dev/null; then
  # Name taken by another folder: add the owner folder, then a counter until the name is free.
  base="$name-$(clean "$extra")"
  name="$base"
  n=2
  while tm has-session -t "=$name" 2>/dev/null; do
    name="$base-$n"
    n=$((n + 1))
  done
fi

if [[ -z "${TMUX:-}" ]]; then
  tm new-session -A -s "$name" -c "$selected" # outside tmux: attach, creating it if needed
else
  tm has-session -t "=$name" 2>/dev/null || tm new-session -ds "$name" -c "$selected"
  tm switch-client -t "=$name" # inside tmux: create detached if missing, then switch
fi
