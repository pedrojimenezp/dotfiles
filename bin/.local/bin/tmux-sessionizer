#!/usr/bin/env bash
# Pick a project folder or feature worktree with fzf and open (or switch to) a tmux session for it.
# Usage: tmux-sessionizer [dir]   (without an argument, pick from the roots; see docs/tmux-sessionizer.md)
#        tmux-sessionizer --list  (print "label<TAB>path" for each candidate and exit)
# Folder convention: <repo>/worktrees/<branch> or <parent>/worktrees/<feature>/<project>;
# any <x>/worktrees/<feature> is a feature session. No git calls.
# Roots: SESSIONIZER_DIRS (space separated), else ~/projects, else $HOME (without go, snap, bin).
# SESSIONIZER_TMUX_ARGS adds tmux options, e.g. "-L sock" for a separate server.
set -euo pipefail # stop on errors, unset variables and failed pipes

read -r -a tmux_args <<<"${SESSIONIZER_TMUX_ARGS:-}" # extra tmux options (empty by default)
tm() { tmux ${tmux_args[@]+"${tmux_args[@]}"} "$@"; } # one place to add tmux options
clean() { printf '%s' "$1" | tr './: ' '----' | tr -s '-'; } # tmux rejects dots and colons

roots=() # only roots that exist
skip=() # find tests for trees that are not projects
if [[ -n "${SESSIONIZER_DIRS:-}" ]]; then
  for d in $SESSIONIZER_DIRS; do [[ -d "$d" ]] && roots+=("$d"); done # missing roots are skipped silently
elif [[ -d "$HOME/projects" ]]; then
  roots=("$HOME/projects")
else
  roots=("$HOME")
  skip=(-path "$HOME/go" -o -path "$HOME/snap" -o -path "$HOME/bin" -o) # caches, not projects
fi

# Features first (<x>/worktrees/<feature>, label "feature  [x]"), then repos (a folder with .git, label = path).
# One find: prune hidden dirs and node_modules, print worktrees/ folders and .git entries without entering them.
list_candidates() {
  local p d f feats="" repos=""
  ((${#roots[@]})) || return 0 # find with no path would search the current directory
  while IFS= read -r p; do
    if [[ "$p" == */worktrees ]]; then
      for f in "$p"/*/; do [[ -d "$f" ]] && feats+="$(basename "$f")  [$(basename "$(dirname "$p")")]"$'\t'"${f%/}"$'\n'; done
    else
      d="${p%/.git}"
      repos+="$d"$'\t'"$d"$'\n'
    fi
  done < <(find -H "${roots[@]}" -mindepth 1 -maxdepth 4 ${skip[@]+"${skip[@]}"} \
    \( \( -name '.*' ! -name .git \) -o -name node_modules \) -prune -o \
    \( -name worktrees -type d -print -prune \) -o \( -name .git -print -prune \) 2>/dev/null || true)
  printf '%s%s' "$feats" "$repos"
}

if [[ "${1:-}" == "--list" ]]; then
  list_candidates
  exit 0
elif [[ $# -eq 1 ]]; then
  selected="$(CDPATH='' cd -- "$1" && pwd -P)" # absolute and symlink-free, so '.' is not named '-'
else
  line="$(list_candidates | fzf --prompt='project> ' --delimiter=$'\t' --with-nth=1 || true)" # show only the label
  [[ -n "$line" ]] || exit 0 # nothing chosen (Esc)
  selected="$(CDPATH='' cd -- "${line#*$'\t'}" && pwd -P)"
fi
"$(dirname "$0")/dotfiles-log" tmux-sessionizer >/dev/null 2>&1 || true # count the run for dotfiles-usage

parent="$(dirname "$selected")"
name="$(clean "$(basename "$selected")")"
if [[ "$(basename "$parent")" == worktrees ]]; then
  extra="$(basename "$(dirname "$parent")")" # the repo or parent folder that owns worktrees/
else
  extra="$(basename "$parent")"
fi

# Reuse a session already started in this folder; popup sessions share the path, never switch into one.
found="$(tm list-sessions -F '#{session_name}'$'\t''#{session_path}' 2>/dev/null |
  awk -F'\t' -v p="$selected" '$1 !~ /^_popup_/ && $2 == p { print $1; exit }' || true)"
if [[ -n "$found" ]]; then
  name="$found"
elif tm has-session -t "=$name" 2>/dev/null; then
  name="$name-$(clean "$extra")" # name taken by another folder; if this is taken too, tmux errors out
fi

if [[ -z "${TMUX:-}" ]]; then
  tm new-session -A -s "$name" -c "$selected" # outside tmux: attach, creating it if needed
else
  tm has-session -t "=$name" 2>/dev/null || tm new-session -ds "$name" -c "$selected"
  tm switch-client -t "=$name" # inside tmux: create detached if missing, then switch
fi
