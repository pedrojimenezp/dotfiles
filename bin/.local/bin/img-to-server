#!/usr/bin/env python3
"""Uploads the clipboard image to an ssh server and pastes the remote path.

With an image on the clipboard it finds the ssh session of the front terminal, copies the
image with scp to /tmp/claude-img/<timestamp>.<ext> on that server (files there older than a
day are deleted), puts the remote path on the clipboard and sends Cmd-V. Without an image it
only sends Cmd-V, so it is harmless to run anywhere. Works with any terminal.

Cmd-V is posted as key events through Quartz (ctypes), so the process that runs this script
needs only the Accessibility permission, never Automation or System Events. If the events
cannot be posted, the path stays on the clipboard and a notification says to press Cmd-V.

What counts as an image on the clipboard:
  1. One copied file with an image extension: uploaded as is, extension kept.
  2. Image data (PNG, TIFF, JPEG, ...), even with text or HTML types beside it: saved with pngpaste.
  3. Anything else (text, several files, other files): normal Cmd-V.

Finding the server, in order:
  1. Front app is iTerm2: the foreground ssh on the current session's tty.
  2. Otherwise: every interactive ssh client with a tty, grouped by resolved host.
     One host is used; several show a native picker; none shows a notification.

Needs pngpaste (brew install pngpaste). Failures show a macOS notification and print to stderr.

Each run appends one block to ~/Library/Logs/img-to-server.log: time, front app, clipboard kind,
target or reason, every command with its exit code and stderr tail, paste method and result.
Clipboard and file contents are never logged. The file is cut to its last 200 KB past 1 MB.

Usage: img-to-server [--dry-run]  (--dry-run only prints the plan)
  --dry-run  print the target, the commands and the log block; upload, paste and log nothing
"""

import ctypes
import datetime
import os
import shlex
import shutil
import signal
import subprocess
import sys
import tempfile
import time
from collections import namedtuple

REMOTE_DIR = "/tmp/claude-img"  # upload folder on the server
UPLOAD_TIMEOUT = 60             # seconds for the whole upload
TITLE = "Image to server"
LOG_PATH = os.path.expanduser("~/Library/Logs/img-to-server.log")
LOG_MAX_BYTES = 1_000_000       # past this size the log is cut
LOG_KEEP_BYTES = 200_000        # what the cut keeps: the newest part
LOG_ERR_TAIL = 200              # characters of stderr kept per command
LOG_CMD_MAX = 300               # characters of a command line kept
KEY_V = 9                       # virtual key code of "v"
FLAG_COMMAND = 0x100000         # kCGEventFlagMaskCommand
HID_EVENT_TAP = 0               # kCGHIDEventTap

# ssh options without a value, and options that take one (OpenSSH `man ssh`).
SSH_FLAGS = set("46AaCfGgKkMNnqsTtVvXxYy")
SSH_VALUE_OPTIONS = set("BbcDEeFIiJLlmOoPpQRSWw")
# Options that mean no interactive shell: never upload through these.
SSH_NON_INTERACTIVE = set("fGNOQsVW")
# Options that choose the host, user, port, keys and config: reused for the upload.
SSH_KEEP_FLAGS = set("46Cq")
SSH_KEEP_VALUE_OPTIONS = set("BbcFIiJlmoPpS")

# ssh options reused by scp. Options scp spells differently become -o settings.
SCP_SAME = {"-4", "-6", "-C", "-q", "-c", "-F", "-i", "-J", "-o"}
SCP_AS_SETTING = {"-p": "Port", "-l": "User", "-b": "BindAddress", "-B": "BindInterface",
                  "-m": "MACs", "-S": "ControlPath"}

# Placed before the session's own options: for -o settings, ssh uses the first value it gets.
UPLOAD_SETTINGS = [
    "-o", "BatchMode=yes",                  # never ask for a password or a host key
    "-o", "ConnectTimeout=10",              # fail fast on a dead host
    "-o", "RequestTTY=no",
    "-o", "RemoteCommand=none",             # a RemoteCommand in ~/.ssh/config would clash with ours
    "-o", "ClearAllForwardings=yes",        # no port forwards that could clash with the open session
    "-o", "ForwardAgent=no",
    "-o", "ForwardX11=no",
    "-o", "PermitLocalCommand=no",
    "-o", "ControlMaster=no",               # reuse an open master connection, never become one
    "-o", "LogLevel=ERROR",                 # no banners in the error text
]

FILE_TYPE = "«class furl»"
IMAGE_EXTENSIONS = {".png", ".jpg", ".jpeg", ".gif", ".webp", ".heic", ".tiff", ".tif", ".bmp"}
# Prints the path of every file on the clipboard, one per line.
FILE_PATHS_SCRIPT = (
    'ObjC.import("AppKit");'
    'var a = $.NSPasteboard.generalPasteboard.readObjectsForClassesOptions('
    '$.NSArray.arrayWithObject($.NSURL), $({NSPasteboardURLReadingFileURLsOnlyKey: true}));'
    'var o = []; if (a) { for (var i = 0; i < a.count; i++) { o.push(ObjC.unwrap(a.objectAtIndex(i).path)); } }'
    'o.join("\\n")')
IMAGE_TYPES = {"«class PNGf»", "TIFF picture", "JPEG picture", "GIF picture", "«class jp2 »", "«class heic»"}

Target = namedtuple("Target", "ssh_path options dest")


def _parse_ssh_options(args, i, keep, state):
    """Reads ssh options from args[i:], appending the reusable ones to keep.

    Sets state["tty"] when -t is seen. Returns the index of the first non-option
    argument, or None for an unknown or non-interactive option. A "--" ends the
    options and is skipped.
    """
    while i < len(args):
        arg = args[i]
        if arg == "--":
            return i + 1
        if not arg.startswith("-") or arg == "-":
            return i
        j = 1
        while j < len(arg):
            opt = arg[j]
            if opt in SSH_NON_INTERACTIVE:
                return None
            if opt in SSH_VALUE_OPTIONS:
                value = arg[j + 1:]
                if not value:                       # value is the next argument
                    i += 1
                    if i >= len(args):
                        return None
                    value = args[i]
                if opt in SSH_KEEP_VALUE_OPTIONS:
                    keep += ["-" + opt, value]
                break
            if opt not in SSH_FLAGS:
                return None
            if opt == "t":
                state["tty"] = True
            if opt in SSH_KEEP_FLAGS:
                keep.append("-" + opt)
            j += 1
        i += 1
    return i


def parse_ssh_argv(argv):
    """Splits an interactive ssh command line into (connection options, destination).

    Options after the destination are read too, as ssh does. Returns None when argv is
    not an interactive login: no destination, -N, -W, -O, ..., or a remote command
    without -t. With -t the command still opens a terminal, so it counts.
    """
    if not argv or os.path.basename(argv[0]) != "ssh":
        return None
    args, keep, state = argv[1:], [], {}
    i = _parse_ssh_options(args, 0, keep, state)
    if i is None or i >= len(args):
        return None
    dest = args[i]
    rest = i + 1
    if rest < len(args) and args[i - 1] != "--" and args[rest].startswith("-"):
        rest = _parse_ssh_options(args, rest, keep, state)
        if rest is None:
            return None
    if rest < len(args) and not state.get("tty"):
        return None
    return keep, dest


def to_scp_options(options):
    """Converts kept ssh options (flat list) to scp options for the same connection."""
    out, i = [], 0
    while i < len(options):
        opt = options[i]
        if opt in ("-4", "-6", "-C", "-q"):
            out.append(opt)
            i += 1
            continue
        value = options[i + 1]
        if opt in SCP_SAME:
            out += [opt, value]
        elif opt in SCP_AS_SETTING:
            out += ["-o", f"{SCP_AS_SETTING[opt]}={value}"]
        i += 2
    return out


def remote_image_path(now, ext=".png"):
    """Returns the upload path for a datetime, e.g. /tmp/claude-img/20261031-142501-123.png."""
    return f"{REMOTE_DIR}/{now:%Y%m%d-%H%M%S}-{now.microsecond // 1000:03d}{ext}"


def prepare_command(ssh_path, target):
    """Returns the ssh argv that creates REMOTE_DIR (mode 700) and deletes files older than a day."""
    folder = shlex.quote(REMOTE_DIR)
    script = f"mkdir -p -m 700 {folder} && find {folder} -type f -mtime +0 -delete"
    return [ssh_path, "-T", *UPLOAD_SETTINGS, *target.options, "--", target.dest, script]


def copy_command(scp_path, target, local, remote_path):
    """Returns the scp argv that copies local to remote_path on the target."""
    return [scp_path, "-q", *UPLOAD_SETTINGS, *to_scp_options(target.options), "--",
            local, f"{target.dest}:{remote_path}"]


def clipboard_types(info):
    """Returns the type names in the output of AppleScript `clipboard info`."""
    parts = [p.strip() for p in info.strip().split(", ")]
    return set(parts[0::2]) if len(parts) > 1 else set()


def clipboard_kind(info):
    """Classifies `clipboard info` output: "file" (a file is copied), "image" (image data) or None.

    A copied file wins over image data, because file managers add an icon image beside it.
    """
    types = clipboard_types(info)
    if FILE_TYPE in types:
        return "file"
    return "image" if types & IMAGE_TYPES else None


def clipboard_image_file():
    """Returns the path of the one image file on the clipboard, or None.

    None when there are several files, a file without an image extension, or no file.
    """
    code, out, _ = osascript(FILE_PATHS_SCRIPT, language="JavaScript")
    paths = [p for p in out.split("\n") if p] if code == 0 else []
    if len(paths) != 1 or not os.path.isfile(paths[0]):
        return None
    return paths[0] if os.path.splitext(paths[0])[1].lower() in IMAGE_EXTENSIONS else None


def process_argv(pid):
    """Returns (executable path, argv) of a process, exact even when arguments hold spaces.

    Reads sysctl KERN_PROCARGS2 (macOS). Returns None if the process is gone or not ours.
    """
    libc = ctypes.CDLL(None, use_errno=True)
    argmax = ctypes.c_int(0)
    size = ctypes.c_size_t(ctypes.sizeof(argmax))
    mib = (ctypes.c_int * 2)(1, 8)                        # CTL_KERN, KERN_ARGMAX
    if libc.sysctl(mib, 2, ctypes.byref(argmax), ctypes.byref(size), None, 0) != 0:
        return None
    buf = ctypes.create_string_buffer(argmax.value)
    size = ctypes.c_size_t(argmax.value)
    mib = (ctypes.c_int * 3)(1, 49, pid)                  # CTL_KERN, KERN_PROCARGS2, pid
    if libc.sysctl(mib, 3, buf, ctypes.byref(size), None, 0) != 0:
        return None
    return parse_procargs2(buf.raw[:size.value])


def parse_procargs2(data):
    """Parses a KERN_PROCARGS2 buffer: argc, executable path, padding, then argv."""
    if len(data) < 4:
        return None
    argc = int.from_bytes(data[:4], "little")
    exe, _, rest = data[4:].partition(b"\0")
    argv = rest.lstrip(b"\0").split(b"\0")[:argc]
    if len(argv) < argc:
        return None
    return exe.decode(errors="replace"), [a.decode(errors="replace") for a in argv]


def find_tool(name):
    """Finds a command on PATH, then in the Homebrew and system folders (a short PATH is common)."""
    path = os.pathsep.join([os.environ.get("PATH", ""), "/opt/homebrew/bin", "/usr/local/bin",
                            "/usr/bin", "/bin"])
    return shutil.which(name, path=path)


LOG_LINES = []  # lines of the current run's log block


def log(text):
    """Adds a line to the current run's log block."""
    LOG_LINES.append(text)


def tail(text, size):
    """Returns the last size characters of text, one line, whitespace trimmed."""
    return " ".join(text.split())[-size:]


def run(argv, timeout=10, data=None):
    """Runs argv like spawn(), and logs the command with its exit code and stderr tail."""
    code, out, err = spawn(argv, timeout, data)
    line = f"cmd: {tail(shlex.join(argv), LOG_CMD_MAX)} -> exit {code}"
    log(line + (f"; stderr: {tail(err, LOG_ERR_TAIL)}" if err.strip() else ""))
    return code, out, err


def spawn(argv, timeout=10, data=None):
    """Runs argv in its own process group; returns (exit code, stdout, stderr) as text.

    Exit code 124 on timeout (the whole group is killed), 127 when it cannot start.
    """
    try:
        proc = subprocess.Popen(argv, stdin=subprocess.PIPE if data is not None else subprocess.DEVNULL,
                                stdout=subprocess.PIPE, stderr=subprocess.PIPE, start_new_session=True)
    except OSError as error:
        return 127, "", str(error)
    try:
        out, err = proc.communicate(data, timeout=max(timeout, 0.1))
    except subprocess.TimeoutExpired:
        try:
            os.killpg(proc.pid, signal.SIGKILL)
        except OSError:
            pass
        proc.communicate()
        return 124, "", f"timed out after {timeout:.0f} seconds"
    return proc.returncode, out.decode(errors="replace"), err.decode(errors="replace")


def osa_quote(text):
    """Quotes text as an AppleScript string literal."""
    return '"' + text.replace("\\", "\\\\").replace('"', '\\"') + '"'


def osascript(script, timeout=10, language=None):
    lang = ["-l", language] if language else []
    return run([find_tool("osascript") or "/usr/bin/osascript", *lang, "-e", script], timeout=timeout)


def notify(text):
    """Shows a macOS notification."""
    log(f"notify: {text}")
    osascript(f"display notification {osa_quote(text)} with title {osa_quote(TITLE)}")


def fail(text):
    """Reports an error on stderr and as a notification; returns the exit code 1."""
    print(f"img-to-server: {text}", file=sys.stderr)
    notify(text)
    return 1


def post_cmd_v():
    """Posts Cmd-V (key down, key up) to the HID event stream with Quartz.

    Needs only Accessibility for this process (or the app that launched it). Raises OSError
    when the CoreGraphics functions cannot be loaded.
    """
    frameworks = "/System/Library/Frameworks/"
    try:
        quartz = ctypes.CDLL(frameworks + "ApplicationServices.framework/ApplicationServices")
        core = ctypes.CDLL(frameworks + "CoreFoundation.framework/CoreFoundation")
        create = quartz.CGEventCreateKeyboardEvent
        set_flags, post, release = quartz.CGEventSetFlags, quartz.CGEventPost, core.CFRelease
    except (OSError, AttributeError) as error:
        raise OSError(f"CoreGraphics is not available: {error}") from error
    create.restype, create.argtypes = ctypes.c_void_p, [ctypes.c_void_p, ctypes.c_uint16, ctypes.c_bool]
    set_flags.argtypes, post.argtypes = [ctypes.c_void_p, ctypes.c_uint64], [ctypes.c_uint32, ctypes.c_void_p]
    release.argtypes = [ctypes.c_void_p]
    for key_down in (True, False):
        event = create(None, KEY_V, key_down)
        if not event:
            raise OSError("CGEventCreateKeyboardEvent returned no event")
        try:
            set_flags(event, FLAG_COMMAND)   # only Command, even while Ctrl is still held
            post(HID_EVENT_TAP, event)
        finally:
            release(event)


def send_paste(path=None):
    """Sends Cmd-V to the front app. Returns (method, error text or None).

    When the key events cannot be posted, the method is "clipboard": path (if given) is put
    on the clipboard and a notification asks for Cmd-V.
    """
    try:
        post_cmd_v()
    except OSError as error:
        log(f"paste: post_cmd_v failed: {error}")
        if path:
            code, _, err = run([find_tool("pbcopy") or "/usr/bin/pbcopy"], data=path.encode())
            if code != 0:
                return "clipboard", f"pbcopy failed: {err.strip()}"
        notify("Path copied: press Cmd+V" if path else "Could not paste: press Cmd+V")
        return "clipboard", None
    return "cgevent", None


def argv_of(pid, args_text):
    """Returns (executable or None, argv) of a process: exact from the kernel, else split from ps."""
    found = process_argv(int(pid))
    return found if found else (None, args_text.split())


def target_from(pid, args_text):
    """Returns the Target for a process if it is an interactive ssh login, else None."""
    exe, argv = argv_of(pid, args_text)
    parsed = parse_ssh_argv(argv)
    if not parsed:
        return None
    ssh_path = exe if exe and os.path.isabs(exe) else (find_tool("ssh") or "/usr/bin/ssh")
    return Target(ssh_path, parsed[0], parsed[1])


def frontmost_app():
    """Returns the name of the front app, or "" if it cannot be read. Needs no permission."""
    code, out, _ = osascript('ObjC.import("AppKit");'
                             '$.NSWorkspace.sharedWorkspace.frontmostApplication.localizedName.js',
                             language="JavaScript")
    return out.strip() if code == 0 else ""


def iterm_foreground_ssh():
    """Returns the Target of the foreground ssh in iTerm2's current session, or None.

    None also when iTerm2 refuses the Apple event or has no window.
    """
    code, out, err = osascript('tell application "iTerm2" to tty of current session of current window')
    tty = out.strip().replace("/dev/", "")
    if code != 0 or not tty:
        log("iterm: no tty" + (" (not authorized to control iTerm2)" if "not authorized" in err.lower() else "")
            + "; using the process list")
        return None
    code, out, _ = run([find_tool("ps") or "/bin/ps", "-t", tty, "-o", "pid=,stat=,args="])
    if code != 0:
        return None
    for line in out.splitlines():
        fields = line.split(None, 2)
        if len(fields) == 3 and "+" in fields[1]:
            target = target_from(fields[0], fields[2])
            if target:
                return target
    return None


def list_ssh_targets():
    """Returns the Targets of every interactive ssh client that has a terminal."""
    code, out, _ = run([find_tool("ps") or "/bin/ps", "-axo", "pid=,tty=,args="])
    targets = []
    for line in out.splitlines() if code == 0 else []:
        fields = line.split(None, 2)
        if len(fields) == 3 and not fields[1].startswith("?"):
            target = target_from(fields[0], fields[2])
            if target:
                targets.append(target)
    return targets


def describe_host(target):
    """Returns (user, hostname, port) as ssh resolves them from its config, or None."""
    code, out, _ = run([target.ssh_path, "-G", *target.options, "--", target.dest], timeout=5)
    if code != 0:
        return None
    conf = dict(line.split(" ", 1) for line in out.splitlines() if " " in line)
    if "hostname" not in conf:
        return None
    return conf.get("user", "?"), conf["hostname"], conf.get("port", "22")


def host_label(target, resolved):
    """Returns "user@hostname[:port]", prefixed with the alias when it differs."""
    if not resolved:
        return target.dest
    user, host, port = resolved
    label = f"{user}@{host}" + ("" if port == "22" else f":{port}")
    return label if target.dest in (host, label) else f"{target.dest} ({label})"


def group_targets(targets):
    """Groups Targets by resolved (user, hostname, port); returns [(label, Target)], first seen first."""
    groups = {}
    for target in targets:
        resolved = describe_host(target)
        key = resolved or (None, target.dest, None)
        if key not in groups:
            groups[key] = (host_label(target, resolved), target)
    return list(groups.values())


def pick_host(labels):
    """Shows a native list and returns the chosen label, or None when cancelled."""
    items = ", ".join(osa_quote(label) for label in labels)
    code, out, _ = osascript(f"choose from list {{{items}}} with prompt "
                             f"{osa_quote('Upload image to which server?')} with title {osa_quote(TITLE)}",
                             timeout=120)
    choice = out.strip()
    return choice if code == 0 and choice and choice != "false" else None


def detect_candidates(front):
    """Returns [(label, Target)]: the iTerm2 foreground ssh when it exists, else every ssh session.

    front is the name of the front app.
    """
    if front == "iTerm2":
        target = iterm_foreground_ssh()
        if target:
            return group_targets([target])
    return group_targets(list_ssh_targets())


def upload(target, dry_run, source=None):
    """Copies an image to the target; returns (remote path, error text or None).

    source is an image file to send as is; without it the clipboard image is saved with
    pngpaste to a temporary file that is always deleted.
    """
    ssh_path = target.ssh_path
    scp_path = find_tool("scp") or "/usr/bin/scp"
    pngpaste = find_tool("pngpaste") or "pngpaste"
    ext = os.path.splitext(source)[1].lower() if source else ".png"
    remote = remote_image_path(datetime.datetime.now(), ext)
    tmp = None if source or dry_run else tempfile.mkdtemp(prefix="img-to-server-")
    local = source or os.path.join(tmp or "/tmp/img-to-server-XXXX", "clipboard.png")
    commands = [] if source else [[pngpaste, local]]
    commands += [prepare_command(ssh_path, target), copy_command(scp_path, target, local, remote)]
    if dry_run:
        for command in commands:
            print("would run:", shlex.join(command))
        return remote, None
    try:
        deadline = time.monotonic() + UPLOAD_TIMEOUT
        for command in commands:
            code, _, err = run(command, timeout=deadline - time.monotonic())
            if code != 0:
                what = os.path.basename(command[0])
                return remote, f"{what} failed: {err.strip()[-300:] or f'exit code {code}'}"
        return remote, None
    finally:
        if tmp:
            shutil.rmtree(tmp, ignore_errors=True)


def write_log(lines, path=LOG_PATH):
    """Appends a block of lines to the log file, first cutting the file to its newest part if it is large."""
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        if os.path.exists(path) and os.path.getsize(path) > LOG_MAX_BYTES:
            with open(path, "rb") as f:
                f.seek(-LOG_KEEP_BYTES, os.SEEK_END)
                kept = f.read().partition(b"\n")[2]        # drop the cut-off first line
            with open(path, "wb") as f:
                f.write(kept)
        with open(path, "a") as f:
            f.write("\n".join(lines) + "\n\n")
    except OSError as error:
        print(f"img-to-server: cannot write {path}: {error}", file=sys.stderr)


def count_use():
    """Appends one line to the usage log of dotfiles-usage; never fails."""
    here = os.path.dirname(os.path.abspath(__file__))
    try:
        subprocess.run([os.path.join(here, "dotfiles-log"), "img-to-server"], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL, timeout=5, check=False)
    except (OSError, subprocess.SubprocessError):
        pass


def main(argv):
    if argv not in ([], ["--dry-run"]):
        print(__doc__, file=sys.stderr)
        return 2
    dry_run = bool(argv)
    if not dry_run:
        count_use()
    LOG_LINES.clear()
    log(f"=== {datetime.datetime.now():%Y-%m-%d %H:%M:%S} ===" + (" (dry run)" if dry_run else ""))
    status = 1
    try:
        status = handle(dry_run)
        return status
    finally:
        log(f"result: exit {status}")
        if dry_run:
            print("would log:")
            print("\n".join("  " + line for line in LOG_LINES))
        else:
            write_log(LOG_LINES, LOG_PATH)


def handle(dry_run):
    """Runs once; returns the exit code."""
    front = frontmost_app()
    log(f"front app: {front or 'unknown'}")
    code, info, _ = osascript("clipboard info")
    kind = clipboard_kind(info) if code == 0 else None
    source = clipboard_image_file() if kind == "file" else None
    if kind == "file" and not source:
        kind = None
    log(f"clipboard: {kind or 'no image'}")
    if not kind:
        log("reason: no image, normal paste")
        if dry_run:
            print("clipboard: no image; would send Cmd-V")
            return 0
        method, error = send_paste()
        log(f"paste: {method}")
        return 0
    if dry_run:
        print(f"clipboard: {source or 'image data'}")

    if kind == "image" and not find_tool("pngpaste") and not dry_run:
        log("reason: pngpaste not found")
        method, _ = send_paste()
        log(f"paste: {method}")
        return fail("pngpaste not found. Install it with: brew install pngpaste")

    candidates = detect_candidates(front)
    if not candidates:
        log("reason: no ssh session found")
        if dry_run:
            print("target: none; would show the notification 'No ssh session found'")
            return 0
        notify("No ssh session found")
        return 0
    if len(candidates) == 1:
        label, target = candidates[0]
    elif dry_run:
        print("targets:", ", ".join(label for label, _ in candidates), "(would show a picker)")
        label, target = candidates[0]
    else:
        choice = pick_host([label for label, _ in candidates])
        if choice is None:
            log("reason: picker cancelled")
            return 0
        label, target = next(c for c in candidates if c[0] == choice)
    print(f"target: {label}")
    log(f"target: {label}")

    remote, error = upload(target, dry_run, source)
    if error:
        log(f"reason: upload failed: {error}")
        return fail(f"Upload to {label} failed. {error}")
    if dry_run:
        print(f"would paste: {remote}")
        return 0
    code, _, err = run([find_tool("pbcopy") or "/usr/bin/pbcopy"], data=remote.encode())
    if code != 0:
        return fail(f"pbcopy failed: {err.strip()}")
    method, error = send_paste(remote)
    log(f"paste: {method}")
    return 0 if not error else fail(f"Could not paste: {error[-300:]}")


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
