#!/usr/bin/env bash
# Search the shortcuts of these dotfiles in fzf: tmux keys, zsh aliases, keys and functions, scripts, cheat sheet.
# Usage: dotfiles-help          (fzf list; tmux opens it in a popup with prefix + ?)
#        dotfiles-help --list   (print the table as "area<TAB>keys<TAB>description<TAB>doc" and exit)
# Everything is read from the repo at every run: bind -N notes in tmux.conf, end-of-line comments in .zshrc,
# line 2 and "# Usage:" lines of bin/.local/bin/*, and docs/cheatsheet.tsv for plugin and terminal keys.
# tmux's own default keys are not listed: prefix + k shows them. Works with macOS bash 3.2.
set -euo pipefail # stop on errors, unset variables and failed pipes

# Repo root: follow the stow symlink (~/.local/bin/dotfiles-help) back into the repo.
# A loop instead of readlink -f, which old macOS readlink lacks; stow links are relative to their folder.
src="${BASH_SOURCE[0]}" # path this script was started as
while [[ -L "$src" ]]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)" # folder that holds the link
  src="$(readlink "$src")"                  # one hop
  [[ "$src" == /* ]] || src="$dir/$src"     # relative target: resolve from the link's folder
done
ROOT="$(cd -P "$(dirname "$src")/../../.." && pwd)" # bin/.local/bin -> repo root

# tmux rows from the bind -N lines of tmux.conf; key names made readable (C-l -> Ctrl+l, A -> Shift+A).
tmux_rows() {
  awk '/^[ \t]*bind / && / -N "/ {
    note = $0; sub(/.* -N "/, "", note); sub(/".*/, "", note)   # text between the quotes after -N
    rest = $0; sub(/ -N "[^"]*"/, "", rest)                      # the line without the note
    n = split(rest, w, /[ \t]+/); keys = "prefix "; key = ""
    for (i = 2; i <= n && key == ""; i++)                        # first word after the flags is the key
      if (w[i] == "-T") keys = (w[++i] == "copy-mode-vi" ? "copy mode: " : w[i] ": ")
      else if (w[i] == "-n") keys = ""
      else if (w[i] != "-r") key = w[i]                         # "-" alone is a key, not a flag
    sub(/^C-/, "Ctrl+", key); sub(/^M-/, "Alt+", key)
    if (key ~ /^[A-Z]$/) key = "Shift+" key                      # uppercase letter: typed with Shift
    printf "tmux\t%s%s\t%s\tdocs/tmux.md\n", keys, key, note
  }' "$ROOT/tmux/.config/tmux/tmux.conf"
}

# zsh rows: alias and bindkey lines with an end-of-line comment, functions with a comment line above.
zsh_rows() {
  awk -v q="'" '
    { c = match($0, /[ \t]#[ \t]/) ? substr($0, RSTART + 3) : "" } # end-of-line comment, if any
    c != "" && match($0, /alias [^=]+=/) && !seen[substr($0, RSTART + 6, RLENGTH - 7)]++ { # first definition of each name
      printf "zsh alias\t%s\t%s\tdocs/zsh.md\n", substr($0, RSTART + 6, RLENGTH - 7), c
    }
    c != "" && $1 == "bindkey" && $2 !~ /^-/ && $2 !~ /O[AB]/ {  # skip the application-mode duplicates of Up/Down
      k = $2; gsub(q, "", k); sub(/\^\[\[A/, "Up", k); sub(/\^\[\[B/, "Down", k); gsub(/\^/, " Ctrl+", k); sub(/^ /, "", k)
      printf "zsh key\t%s\t%s\tdocs/zsh.md\n", k, c
    }
    /^# / && (prev !~ /^# / || prev ~ /^# --- /) { top = $0 }    # top line of a comment block, below any "--- title ---"
    /^[a-z][a-z0-9_]*\(\) *\{/ && prev ~ /^# / {                  # documented function: "# name args: what it does"
      d = substr(top, 3); k = d; sub(/: .*/, "", k); sub(/^[^:]*: /, "", d)
      printf "zsh function\t%s\t%s\tdocs/zsh.md\n", k, d
    }
    { prev = $0 }
  ' "$ROOT/zsh/.zshrc"
}

# Script rows: the description on line 2 and "# Usage: cmd  (what it does)" lines.
script_rows() {
  local f
  for f in "$ROOT"/bin/.local/bin/*; do
    awk -v name="${f##*/}" '
      FNR == 2 { d = substr($0, 3); sub("^" name ": ", "", d); printf "command\t%s\t%s\tbin/.local/bin/%s\n", name, d, name }
      /^# (Usage:| )/ && match($0, /  +\(.*\)$/) {
        k = substr($0, 3, RSTART - 3); sub(/^(Usage:)? */, "", k)
        d = substr($0, RSTART); sub(/^ *\(/, "", d); sub(/\)$/, "", d)   # text inside the parentheses
        if (k != name) printf "command\t%s\t%s\tbin/.local/bin/%s\n", k, d, name
      }' "$f"
  done
}

rows() { tmux_rows; zsh_rows; script_rows; grep -v '^#' "$ROOT/docs/cheatsheet.tsv"; }

case "${1:-}" in
  --list) rows; exit 0 ;;                                   # plain table for scripts and tests
  "") ;;                                                    # interactive
  *) sed -n '2,7s/^# //p' "$0"; exit 2 ;;                   # unknown option: show the header
esac

command -v fzf >/dev/null 2>&1 || { rows | column -t -s $'\t' | "${PAGER:-less}"; exit 0; } # no fzf: plain table

# Padded display column for fzf, then the raw fields (hidden) for the preview.
rows | awk -F'\t' '{ printf "%-12s  %-26s  %s\t%s\t%s\t%s\t%s\n", $1, $2, $3, $1, $2, $3, $4 }' |
  fzf --delimiter=$'\t' --with-nth=1 --layout=reverse --tiebreak=index --prompt="keys> " \
    --header="prefix = Ctrl+Space · type to filter · Esc closes · prefix k: tmux defaults" \
    --preview='printf "%s  |  %s\n\n%s\n\nMore: %s\n" {2} {3} {4} {5}' --preview-window=down,6,wrap \
    >/dev/null || true # Esc or Enter just closes (fzf exits 130 on Esc)
