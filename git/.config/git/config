# ~/.config/git/config: global git config (read before ~/.gitconfig, which therefore wins and should not exist).

[init]
	defaultBranch = main

[core]
	pager = delta
	excludesFile = ~/.config/git/ignore

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	line-numbers = true
	syntax-theme = ansi                   # highlight code with the terminal's 16 colors (follows any theme)
	detect-dark-light = auto              # pick light or dark diff backgrounds from the terminal background

[pull]
	rebase = true

[rebase]
	autoStash = true
	autoSquash = true                     # apply fixup!/squash! commits automatically

[push]
	autoSetupRemote = true

[fetch]
	prune = true

[diff]
	colorMoved = default                  # color moved lines differently from added/removed
	algorithm = histogram                 # better diffs than the default algorithm

[merge]
	conflictstyle = diff3                 # show base text in conflict markers (zdiff3 needs git 2.35+, fatal on Ubuntu 22.04)

[rerere]
	enabled = true

[url "ssh://git@github.com/"]
	pushInsteadOf = https://github.com/   # push over SSH; the slashes keep github.company.com out; fetch stays https

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true                       # fail if git-lfs is missing

[alias]
	st = status -sb
	co = checkout
	sw = switch
	br = branch -vv                       # branches with upstream info
	lg = log --oneline --graph --decorate -20  # compact graph log
	last = log -1 --stat                  # show the last commit
	unstage = restore --staged
	amend = commit --amend --no-edit

# HTTPS GitHub remotes use the `gh auth login` token. The empty `helper =` drops older
# helpers (e.g. a stale keychain token). Without gh this does nothing. SSH is unaffected.
[credential "https://github.com"]
	helper =
	helper = "!f() { command -v gh >/dev/null 2>&1 && gh auth git-credential \"$@\"; }; f"
[credential "https://gist.github.com"]
	helper =
	helper = "!f() { command -v gh >/dev/null 2>&1 && gh auth git-credential \"$@\"; }; f"

[include]
	path = ~/.config/git/local            # machine-specific overrides (untracked)
