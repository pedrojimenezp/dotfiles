[init]
	defaultBranch = main

[core]
	pager = delta
	excludesFile = ~/.config/git/ignore

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	line-numbers = true
	syntax-theme = ansi                   # follows any terminal theme
	detect-dark-light = auto

[pull]
	rebase = true

[rebase]
	autoStash = true
	autoSquash = true

[push]
	autoSetupRemote = true

[fetch]
	prune = true

[diff]
	colorMoved = default
	algorithm = histogram

[merge]
	conflictstyle = diff3                 # zdiff3 needs git 2.35+ (fails on Ubuntu 22.04)

[rerere]
	enabled = true

[url "ssh://git@github.com/"]
	pushInsteadOf = https://github.com/   # push over SSH, fetch stays HTTPS; slashes keep github.company.com out

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

[alias]
	st = status -sb
	co = checkout
	sw = switch
	br = branch -vv
	lg = log --oneline --graph --decorate -20
	last = log -1 --stat
	unstage = restore --staged
	amend = commit --amend --no-edit
	wip = !git-changes wip                # uncommitted + untracked through delta; -s side by side
	pr = !git-changes pr                  # branch since base + untracked; git pr [-s] [base]

# HTTPS GitHub auth via gh; empty helper drops stale ones
[credential "https://github.com"]
	helper =
	helper = "!f() { command -v gh >/dev/null 2>&1 && gh auth git-credential \"$@\"; }; f"
[credential "https://gist.github.com"]
	helper =
	helper = "!f() { command -v gh >/dev/null 2>&1 && gh auth git-credential \"$@\"; }; f"

[include]
	path = ~/.config/git/local            # untracked; last, so it wins
